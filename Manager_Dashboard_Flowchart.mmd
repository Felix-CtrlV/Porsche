%% Manager Dashboard Complete Flow
graph TB
    Start([Login Screen]) --> Input[User enters Username & Password]
    Input --> Login[Click Login Button]
    Login --> Validate{Validate Input}
    Validate -->|Empty| Error1[Show Error]
    Error1 --> Input
    Validate -->|Valid| DBAuth[Call DB login]
    DBAuth -->|Failed| Error2[Show Error]
    Error2 --> Input
    DBAuth -->|Success| GetUser[Get User Data]
    GetUser --> CheckRole{Check User Role}
    CheckRole -->|Admin| AdminDash[Admin Dashboard]
    CheckRole -->|Manager| ManagerDash[Manager Dashboard]
    CheckRole -->|Staff| StaffDash[Staff Dashboard]
    ManagerDash --> CreateSession[Create Session]
    CreateSession --> LoadDash[Load Manager Dashboard]
    
    LoadDash --> MainNav[Main Navigation]
    MainNav --> Overview[Overview View]
    MainNav --> Inventory[Inventory View]
    MainNav --> Orders[Orders View]
    MainNav --> Staffs[Staffs View]
    MainNav --> Settings[Settings Panel]
    MainNav --> Logout[Logout]
    
    Overview --> SalesCharts[Sales Performance Charts]
    Overview --> BestSellers[Best Sellers Section]
    Overview --> Attendance[Attendance & Target Carousel]
    
    Inventory --> InvView[View Toggle: Cars/Parts]
    Inventory --> InvAdd[Add Item]
    Inventory --> InvEdit[Edit Item]
    Inventory --> InvDelete[Delete Item]
    Inventory --> InvExport[Export CSV]
    Inventory --> InvSearch[Search Items]
    
    Orders --> OrdersTable[Orders Table]
    Orders --> OrderDetails[View Order Details]
    Orders --> OrderSearch[Search Orders]
    Orders --> OrderFilter[Date Filter]
    
    Staffs --> StaffCards[Staff Cards List]
    Staffs --> StaffDetails[Staff Details]
    Staffs --> StaffPerf[Performance Data]
    Staffs --> StaffOrders[Staff Orders]
    Staffs --> StaffSearch[Search Staff]
    
    Settings --> Profile[View Profile]
    Settings --> ChangePW[Change Password]
    Settings --> Setup2FA[Setup 2FA]
    
    Logout --> LogoutDB[Update DB Logout]
    LogoutDB --> CloseWindow[Close Dashboard]
    CloseWindow --> ReturnLogin[Return to Login]
    ReturnLogin --> End([END])
    
    style Start fill:#e1f5ff
    style ManagerDash fill:#90ee90
    style End fill:#ffcccb
    style MainNav fill:#fff9c4
    style Overview fill:#b3e5fc
    style Inventory fill:#c8e6c9
    style Orders fill:#f8bbd0
    style Staffs fill:#d1c4e9
    style Settings fill:#ffe0b2
