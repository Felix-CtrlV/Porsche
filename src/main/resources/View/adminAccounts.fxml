                            <VBox spacing="10.0" styleClass="management-section management-section-bonus">
                                <children>
                                    <Label styleClass="management-section-title management-section-title-bonus" text="🎁 Bonus Calculation" />
                                    <Label fx:id="bonusInfoLabel" style="-fx-text-fill: #78350f; -fx-font-size: 12; -fx-wrap-text: true;" text="Bonus is calculated based on target achievement for the current month." wrapText="true" />
                                    
                                    <!-- Target Progress -->
                                    <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                <children>
                                                    <Label style="-fx-text-fill: #78350f; -fx-font-weight: bold;" text="Car Sales:" />
                                                    <Label fx:id="carTargetLabel" style="-fx-text-fill: #92400e;" text="0/0" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="carBonusLabel" style="-fx-text-fill: #10b981; -fx-font-weight: bold;" text="+0%" />
                                                </children>
                                            </HBox>
                                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                <children>
                                                    <Label style="-fx-text-fill: #78350f; -fx-font-weight: bold;" text="Parts Sales:" />
                                                    <Label fx:id="partTargetLabel" style="-fx-text-fill: #92400e;" text="0/0" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="partBonusLabel" style="-fx-text-fill: #10b981; -fx-font-weight: bold;" text="+0%" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                    
                                    <VBox spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #fbbf24; -fx-border-radius: 5;">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                <children>
                                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 14;" text="Total Bonus:" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label fx:id="totalBonusLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="0 MMK" />
                                                </children>
                                            </HBox>
                                            <Label fx:id="bonusBreakdownLabel" style="-fx-text-fill: #64748b; -fx-font-size: 11; -fx-wrap-text: true;" text="No bonus earned this month" wrapText="true" />
                                        </children>
                                    </VBox>
                                    
                                    <Button fx:id="applyBonusBtn" mnemonicParsing="false" onAction="#onApplyBonus" style="-fx-background-color: #fbbf24; -fx-text-fill: #78350f; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="Apply Bonus">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Button>
                                </children>
                            </VBox>
                            
                            <!-- Termination Section -->
                            <VBox spacing="10.0" styleClass="management-section management-section-termination">
                                <children>
                                    <Label styleClass="management-section-title management-section-title-termination" text="⚠ Employee Termination" />
                                    <Label style="-fx-text-fill: #7f1d1d; -fx-font-size: 12; -fx-wrap-text: true;" text="This action will terminate the employee and mark them as inactive. This cannot be undone." wrapText="true" />
                                    <VBox spacing="5.0">
                                        <children>
                                            <Label style="-fx-text-fill: #7f1d1d; -fx-font-weight: bold;" text="Reason for Termination:" />
                                            <TextArea fx:id="terminationReasonField" prefHeight="80.0" promptText="Enter the reason for termination..." style="-fx-padding: 1; ra: ;" styleClass="admin-text-area" wrapText="true" />
                                        </children>
                                    </VBox>
                                    <Button fx:id="terminateEmployeeBtn" mnemonicParsing="false" onAction="#onTerminateEmployee" styleClass="admin-action-button-danger" text="Terminate Employee">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Button>
                                </children>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
</StackPane>
