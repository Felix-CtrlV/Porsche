<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane styleClass="root-pane" stylesheets="@../CSS/cars.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffCarsController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="0" styleClass="main-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Header ကတော့အတိုင်းပဲထားပါ -->

            <VBox alignment="CENTER" spacing="8" styleClass="title-section" VBox.vgrow="NEVER">
                <children>
                    <Label styleClass="main-title" text="SELECT YOUR MODEL" />
                    <Label styleClass="subtitle" text="Choose the Porsche that defines you" />
                </children>
                <padding>
                    <Insets bottom="20.0" top="10.0" />
                </padding>
            </VBox>

            <Line endX="1000" startX="0" styleClass="divider-line" VBox.vgrow="NEVER">
                <VBox.margin>
                    <Insets bottom="20.0" left="40.0" right="40.0" />
                </VBox.margin>
            </Line>

            <GridPane alignment="CENTER" hgap="24" styleClass="models-grid" vgap="24" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="20" left="40" right="40" top="20" />
                </padding>

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints percentHeight="50" vgrow="ALWAYS" />
                    <RowConstraints percentHeight="50" vgrow="ALWAYS" />
                </rowConstraints>

                <children>
                    <!-- Row 1 - StackPane တွေကို image size အတိုင်းကန့်သတ်ထားတယ် -->
                    <StackPane maxHeight="200" maxWidth="300" prefHeight="200" prefWidth="300" styleClass="model-tile-container" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <ImageView fx:id="nine11_select_image" fitWidth="300" preserveRatio="true" smooth="true" styleClass="model-image" />
                    </StackPane>

                    <StackPane maxHeight="200" maxWidth="300" prefHeight="200" prefWidth="300" styleClass="model-tile-container" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <ImageView fx:id="seven18_select_image" fitWidth="300" preserveRatio="true" smooth="true" styleClass="model-image" />
                    </StackPane>

                    <StackPane maxHeight="200" maxWidth="300" prefHeight="200" prefWidth="300" styleClass="model-tile-container" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <ImageView fx:id="taycan_select_image" fitWidth="300" preserveRatio="true" smooth="true" styleClass="model-image" />
                    </StackPane>

                    <!-- Row 2 -->
                    <StackPane maxHeight="200" maxWidth="300" prefHeight="200" prefWidth="300" styleClass="model-tile-container" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <ImageView fx:id="panamera_select_image" fitWidth="300" preserveRatio="true" smooth="true" styleClass="model-image" />
                    </StackPane>

                    <StackPane maxHeight="200" maxWidth="300" prefHeight="200" prefWidth="300" styleClass="model-tile-container" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <ImageView fx:id="macan_select_image" fitWidth="300" preserveRatio="true" smooth="true" styleClass="model-image" />
                    </StackPane>

                    <StackPane maxHeight="200" maxWidth="300" prefHeight="200" prefWidth="300" styleClass="model-tile-container" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <ImageView fx:id="cayenne_select_image" fitWidth="300" preserveRatio="true" smooth="true" styleClass="model-image" />
                    </StackPane>
                </children>
            <VBox.margin>
               <Insets left="100.0" right="100.0" />
            </VBox.margin>
            </GridPane>

            <Line endX="1000" startX="0" styleClass="divider-line" VBox.vgrow="NEVER">
                <VBox.margin>
                    <Insets bottom="20.0" left="40.0" right="40.0" top="30.0" />
                </VBox.margin>
            </Line>
        </VBox>
    </children>
</AnchorPane>
