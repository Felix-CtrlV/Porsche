                                            </cursor>
                                        </Button>
                                        <Button fx:id="changePasswordBtn" onAction="#showChangePasswordDialog" prefHeight="48.0" prefWidth="380.0" style="-fx-background-color: white; -fx-text-fill: #1f2937; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: #e5e7eb; -fx-border-width: 2; -fx-border-radius: 10; -fx-cursor: hand;" text="🔐  Change Password">
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- Attendance Management Dialog (slides from top) -->
        <VBox fx:id="attendancePane" alignment="CENTER" maxHeight="550.0" maxWidth="900.0" prefHeight="550.0" prefWidth="900.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 5);" translateY="-700.0" visible="false" StackPane.alignment="CENTER">
            <StackPane.margin>
                <Insets top="30.0" />
            </StackPane.margin>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="40.0" prefHeight="57.0" prefWidth="870.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-background-radius: 12 12 0 0; -fx-padding: 15 20;">
                    <children>
                        <StackPane minHeight="40.0" minWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20;">
                            <Label style="-fx-font-size: 20; -fx-text-fill: white;" text="📅" />
                     <HBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </HBox.margin>
                        </StackPane>
                        <Label prefHeight="20.0" prefWidth="775.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Attendance Management" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </HBox.margin></Label>
                        <Label fx:id="closeAttendanceDialogBtn" onMouseClicked="#closeAttendanceDialog" style="-fx-font-size: 18; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                            <HBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </HBox.margin></Label>
                    </children>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </HBox>

                <!-- Attendance Content (will be loaded from managerAttendanceManagement.fxml) -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane fx:id="attendanceContentPane" style="-fx-padding: 20;">
                        </StackPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- Toast Notification (top center) -->
        <HBox fx:id="toastNotification" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="360.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 16; -fx-border-color: #e5e7eb; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0, 0, 4);" translateY="-100" visible="false" StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets top="60.0" />
            </StackPane.margin>
            <children>
                <StackPane minHeight="36.0" minWidth="36.0" style="-fx-background-color: #10b981; -fx-background-radius: 18;">
                    <children>
                        <Label fx:id="toastIcon" style="-fx-font-size: 18; -fx-text-fill: white;" text="✓" />
                    </children>
                </StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="toastTitle" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Success" />
                        <Label fx:id="toastMessage" style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Operation completed successfully" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Confirmation Dialog Overlay -->
        <Pane fx:id="confirmOverlay" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

        <!-- Confirmation Dialog (top center) -->
        <VBox fx:id="confirmDialog" alignment="CENTER" maxHeight="-Infinity" maxWidth="400.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 5);" translateY="-600.0" visible="false" StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets top="100.0" />
            </StackPane.margin>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="57.0" prefHeight="57.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 12 12 0 0; -fx-padding: 15 20;">
                    <children>
                        <StackPane minHeight="40.0" minWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20;">
                            <children>
                                <Label fx:id="confirmIcon" style="-fx-font-size: 20; -fx-text-fill: white;" text="⚠" />
                            </children>
                        </StackPane>
                        <Label fx:id="confirmTitle" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Confirm Action" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- Content -->
                <VBox fx:id="confirmContent" spacing="10.0" style="-fx-padding: 15;">
                    <children>
                        <Label fx:id="confirmMessage" style="-fx-font-size: 13; -fx-text-fill: #374151; -fx-wrap-text: true;" text="Are you sure you want to proceed?" wrapText="true" />
                    </children>
                </VBox>

                <!-- Buttons -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 0 15 15 15;">
                    <children>
                        <Button fx:id="confirmCancelBtn" onAction="#onConfirmCancel" prefHeight="38.0" prefWidth="170.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancel">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        <Button fx:id="confirmOkBtn" onAction="#onConfirmOk" prefHeight="38.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 2);" text="Confirm">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Change Password Dialog (slides from top) -->
        <VBox fx:id="changePasswordDialog" alignment="CENTER" maxHeight="-Infinity" maxWidth="400.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 5);" translateY="-700.0" visible="false" StackPane.alignment="CENTER">
            <StackPane.margin>
                <Insets top="50.0" />
            </StackPane.margin>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="40.0" prefHeight="57.0" prefWidth="370.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 12 12 0 0; -fx-padding: 15 20;">
                    <children>
                        <StackPane minHeight="40.0" minWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20;">
                            <Label style="-fx-font-size: 20; -fx-text-fill: white;" text="🔐" />
                        </StackPane>
                        <Label prefHeight="20.0" prefWidth="275.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Change Password" HBox.hgrow="ALWAYS" />
                        <Label fx:id="closePasswordDialogBtn" onMouseClicked="#closePasswordDialog" style="-fx-font-size: 18; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Label>
                    </children>
                </HBox>

                <!-- Content Area -->
                <StackPane style="-fx-padding: 15;">
                    <!-- Step 1: Current Password -->
                    <VBox fx:id="passwordVerificationPane" alignment="CENTER" spacing="10.0" visible="true">
                        <VBox alignment="CENTER" spacing="3.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Step 1: Verify Current Password" />
                            <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Enter your current password to proceed" textAlignment="CENTER" wrapText="true" />
                        </VBox>

                        <VBox spacing="6.0" style="-fx-max-width: 340;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Current Password" />
                            <PasswordField fx:id="currentPasswordField" promptText="Enter your current password" style="-fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                        </VBox>

                        <Button fx:id="verifyCurrentPasswordBtn" onAction="#onVerifyCurrentPassword" prefHeight="38.0" prefWidth="340.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 2);" text="Verify &amp; Send OTP">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Label fx:id="passwordVerifyStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- Step 2: OTP Verification -->
                    <VBox fx:id="otpVerificationPane" alignment="CENTER" spacing="10.0" visible="false">
                        <VBox alignment="CENTER" spacing="3.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Step 2: Verify OTP" />
                            <Label fx:id="otpEmailLabel" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Enter the 6-digit code sent to your email" textAlignment="CENTER" wrapText="true" />
                        </VBox>

                        <VBox spacing="6.0" style="-fx-max-width: 340;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="OTP Code" />
                            <TextField fx:id="otpField" promptText="Enter 6-digit OTP" style="-fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                        </VBox>

                        <Button fx:id="verifyOtpBtn" onAction="#onVerifyOTP" prefHeight="38.0" prefWidth="340.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 2);" text="Verify OTP">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Button fx:id="resendOtpBtn" onAction="#onResendOTP" prefHeight="32.0" prefWidth="340.0" style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-font-size: 12; -fx-font-weight: 600; -fx-cursor: hand; -fx-underline: true;" text="Resend OTP">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Label fx:id="otpVerifyStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- Step 3: New Password -->
                    <VBox fx:id="newPasswordPane" alignment="CENTER" spacing="10.0" visible="false">
                        <VBox alignment="CENTER" spacing="3.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Step 3: Set New Password" />
                            <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Create a strong password for your account" textAlignment="CENTER" wrapText="true" />
                        </VBox>

                        <VBox spacing="8.0" style="-fx-max-width: 340;">
                            <VBox spacing="6.0">
                                <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="New Password" />
                                <PasswordField fx:id="newPasswordField" promptText="Enter new password" style="-fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                            </VBox>

                            <VBox spacing="6.0">
                                <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Confirm Password" />
                                <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" style="-fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                            </VBox>
                        </VBox>

                        <Button fx:id="changePasswordBtn" onAction="#onSubmitPasswordChange" prefHeight="38.0" prefWidth="340.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 2);" text="✓ Change Password">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Label fx:id="changePasswordStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
                    </VBox>
                    <!-- Loading Indicator -->
                    <StackPane fx:id="passwordLoadingPane" style="-fx-background-color: rgba(255,255,255,0.95);" visible="false">
                        <VBox alignment="CENTER" spacing="10.0">
                            <ProgressIndicator prefHeight="40.0" prefWidth="40.0" style="-fx-progress-color: #667eea;" />
                            <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #667eea;" text="Processing..." />
                        </VBox>
                    </StackPane>
                </StackPane>

                <!-- Message Bar (Login notification style) -->
                <StackPane fx:id="passwordMessagePane" opacity="0" prefHeight="40.0" style="-fx-background-radius: 12 12 0 0; -fx-background-color: rgb(255, 60, 41); -fx-border-width: 2; -fx-border-radius: 12 12 0 0; -fx-border-color: rgb(255, 102, 40);" translateY="40">
                    <Label fx:id="passwordMessageLabel" style="-fx-text-fill: white;" styleClass="selected_dash_font" stylesheets="@../CSS/DashBoard_general.css" text="Success!">
                        <padding>
                            <Insets bottom="3.0" />
                        </padding>
                    </Label>
                </StackPane>
            </children>
        </VBox>
    </children>
</StackPane>
