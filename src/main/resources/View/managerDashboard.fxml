<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>

<StackPane minHeight="605.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.managerDashboardController">
    <children>
        <BorderPane fx:id="root" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefHeight="580.0" prefWidth="1188.0" stylesheets="@../CSS/DashBoard_general.css">
            <center>
                <AnchorPane fx:id="admin_anc" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
            </center>
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="37.0" prefWidth="200.0" styleClass="glass_main" BorderPane.alignment="CENTER">
                    <children>
                        <ImageView fx:id="img" fitHeight="35.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Image/porsche_logo.png" />
                            </image>
                            <HBox.margin>
                                <Insets left="17.0" />
                            </HBox.margin>
                        </ImageView>
                        <Line endX="-100.0" endY="30.0" startX="-100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="5.0" />
                            </HBox.margin>
                        </Line>
                        <VBox alignment="CENTER_LEFT" prefHeight="39.0" prefWidth="67.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome :" />
                                <Label fx:id="nameLbl" styleClass="selected_dash_font" text="Admin" />
                            </children>
                        </VBox>
                        <Region maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefHeight="35.0" prefWidth="323.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="homebtn" onAction="#clickhome" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Home" HBox.hgrow="NEVER" />
                        <Button fx:id="Inventroybtn" onAction="#clickInventory" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Inventory" HBox.hgrow="NEVER" />
                        <Button fx:id="ordersbtn" onAction="#clickOrders" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Orders" HBox.hgrow="NEVER" />
                  <Button fx:id="staffbtn" onAction="#clickstaff" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Staff" />
                        <Region maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="360.0" HBox.hgrow="ALWAYS" />
                        <StackPane minWidth="88.0" HBox.hgrow="NEVER">
                     <children>
                        <Label fx:id="settingIcon" prefHeight="34.0" prefWidth="33.0" style="-fx-alignment: center; -fx-font-size: 30;" text="⚙" />
                     </children></StackPane>
                    </children>
                </HBox>
            </top>
        </BorderPane>
        <Pane fx:id="overlayPane" opacity="0.5" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: black;" visible="false" />
        <AnchorPane fx:id="settingPane" maxWidth="350.0" prefHeight="580.0" prefWidth="1060.0" style="-fx-background-radius: 30 0 0 30;" styleClass="black-pane" translateX="350.0" StackPane.alignment="CENTER_RIGHT">
            <stylesheets>
                <URL value="@../CSS/DashBoard_general.css" />
                <URL value="@../CSS/login.css" />
            </stylesheets>
            <children>
                <Button fx:id="logoutbtn" layoutX="17.0" layoutY="519.0" onAction="#clickLogout" prefHeight="47.0" prefWidth="322.0" style="-fx-background-radius: 20 0 0 20;" styleClass="logoutbtn" text="LogOut" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="17.0" AnchorPane.rightAnchor="11.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
