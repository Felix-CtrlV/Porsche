<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<HBox maxHeight="120.0" maxWidth="500.0" minHeight="120.0" minWidth="300.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.bestSellerController">
   <children>
      <StackPane maxHeight="120.0" maxWidth="500.0" minHeight="120.0" minWidth="300.0" HBox.hgrow="ALWAYS">
          <children>
              <!-- Modern Card Background -->
              <Rectangle fx:id="cardBackground" arcHeight="14" arcWidth="14" height="120.0" width="500.0" styleClass="bestSellerCard">
                  <effect>
                      <DropShadow color="rgba(15,23,42,0.06)" offsetX="0" offsetY="2" radius="8" />
                  </effect>
              </Rectangle>
      
              <HBox minHeight="120.0" minWidth="500.0" prefHeight="120.0" prefWidth="500.0" spacing="12" StackPane.alignment="CENTER">
                  <children>
                      <!-- Image Section on Left -->
                      <StackPane prefHeight="120.0" prefWidth="100.0" style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
                          <children>
                              <ImageView fx:id="image" fitHeight="90.0" fitWidth="90.0" onMouseClicked="#clickStaffImage" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 8, 0, 0, 0);">
                                 <image>
                                    <Image url="@../Image/usericon.png" />
                                 </image>
                                 <clip>
                                    <javafx.scene.shape.Circle centerX="45.0" centerY="45.0" radius="45.0" />
                                 </clip>
                              </ImageView>
                          </children>
                          <padding>
                              <Insets left="8" right="4" />
                          </padding>
                      </StackPane>
      
                      <!-- Content Section on Right -->
                      <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                          <padding>
                              <Insets bottom="12.0" left="20.0" right="16.0" top="12.0" />
                          </padding>
                          
                          <!-- Name and Rank Row -->
                          <HBox alignment="CENTER_LEFT" spacing="12">
                              <children>
                                  <Label fx:id="name" styleClass="cardName" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI', system;" text="John Smith" />
                                  <Label fx:id="rank" styleClass="cardRank" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', system;" text="#1" />
                              </children>
                          </HBox>
                          
                          <!-- Units Sold Row -->
                          <HBox alignment="CENTER_LEFT" spacing="8">
                              <children>
                                  <Label styleClass="cardLabel" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-font-family: 'Segoe UI', system;" text="Sold" />
                                  <Label fx:id="soldRevenue" styleClass="cardSold" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-font-family: 'Segoe UI', system;" text="1 Units" />
                              </children>
                          </HBox>
                          
                          <!-- Revenue Rate Row -->
                          <Label fx:id="revenueRate" styleClass="cardRevenueRate" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-font-family: 'Segoe UI', system;" text="+12% this month" wrapText="true" />
                      </VBox>
                  </children>
              </HBox>
          </children>
      </StackPane>
   </children>
</HBox>
