<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="122.0" prefWidth="434.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Modern Card Background - 60% Dominant Color -->
        <Rectangle arcHeight="14" arcWidth="14" height="121.0" width="435.0">
            <fill>
                <LinearGradient endX="1.0" endY="1.0">
                    <stops>
                        <Stop color="#ffffff" offset="0.0" />
                        <Stop color="#fafbfc" offset="1.0" />
                    </stops>
                </LinearGradient>
            </fill>
            <stroke>
                <LinearGradient endX="1.0" endY="1.0">
                    <stops>
                        <Stop color="#f1f5f9" offset="0.0" />
                        <Stop color="#e2e8f0" offset="1.0" />
                    </stops>
                </LinearGradient>
            </stroke>
            <effect>
                <DropShadow color="rgba(15,23,42,0.06)" offsetX="0" offsetY="2" radius="8" />
            </effect>
        </Rectangle>

        <HBox prefHeight="122.0" prefWidth="386.0" spacing="0">
            <children>
                <!-- Profile Section - 30% Secondary Color Area -->
                <StackPane prefHeight="120.0" prefWidth="100.0" style="-fx-background-color: #f8fafc;">
                    <children>
                        <!-- Modern Profile Avatar -->
                        <Circle fill="#ffffff" radius="32.0" stroke="#3b82f6" strokeWidth="2.5">
                            <effect>
                                <DropShadow color="rgba(59,130,246,0.2)" offsetX="0" offsetY="2" radius="4" />
                            </effect>
                        </Circle>
                        <!-- Enhanced Profile Icon -->
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #3b82f6; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 2, 0, 0, 1);" text="💼" />
                    </children>
                    <padding>
                        <Insets left="16" right="16" />
                    </padding>
                </StackPane>

                <!-- Content Section -->
                <StackPane alignment="CENTER_LEFT" minHeight="120.0" prefHeight="122.0" prefWidth="330.0">
                    <GridPane alignment="CENTER_LEFT" hgap="12" minHeight="120.0" minWidth="240.0" prefHeight="122.0" prefWidth="322.0" style="-fx-background-color: transparent;" vgap="6">
                        <padding>
                            <Insets bottom="16" left="16" right="16" top="16" />
                        </padding>

                        <!-- Personal Details Block -->
                        <VBox alignment="CENTER_LEFT" prefHeight="27.0" prefWidth="163.0" spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox prefHeight="100.0" prefWidth="200.0" spacing="6.0">
                                <children>
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', system;" text="John Smith" />
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <children>
                                            <Label style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #f59e0b; -fx-font-family: 'Segoe UI', system;" text="#1">
                                                <font>
                                                    <Font size="20.0" />
                                                </font>
                                            </Label>
                                            <StackPane alignment="CENTER">
                                                <children>
                                                    <Label style="-fx-font-size: 10px; -fx-font-weight: 900; -fx-text-fill: #ffffff; -fx-font-family: 'Segoe UI', system;" text="1" />
                                                </children>
                                            </StackPane>
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>
                        </VBox>

                        <!-- Rank Badge Block - 10% Accent Color -->
                        <StackPane alignment="TOP_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <!-- Section Divider -->
                        <Rectangle arcHeight="4" arcWidth="4" fill="#f1f5f9" height="2" width="208" GridPane.columnSpan="2" GridPane.rowIndex="1" />

                        <!-- Work Metrics Block -->
                        <GridPane hgap="16" style="-fx-background-color: transparent;" vgap="4" GridPane.columnSpan="2" GridPane.rowIndex="2">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            </columnConstraints>

                            <!-- Work Hours Metric -->
                            <VBox alignment="CENTER_LEFT" spacing="1" GridPane.columnIndex="0">
                                <Label style="-fx-font-size: 9px; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-font-family: 'Segoe UI', system; -fx-letter-spacing: 0.8;" text="WORK HOURS" />
                                <Label style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #2563eb; -fx-font-family: 'Segoe UI', system;" text="40 hrs" />
                                <Label style="-fx-font-size: 8px; -fx-text-fill: #10b981; -fx-font-weight: 600; -fx-font-family: 'Segoe UI', system;" text="+5% this month" />
                            </VBox>

                            <!-- Vertical Separator -->
                            <Rectangle arcHeight="2" arcWidth="2" fill="#e2e8f0" height="32" width="1.5" GridPane.columnIndex="0" GridPane.halignment="RIGHT">
                                <effect>
                                    <InnerShadow color="rgba(0,0,0,0.05)" radius="1" />
                                </effect>
                            </Rectangle>

                            <!-- Sales Metric -->
                            <VBox alignment="CENTER_LEFT" spacing="1" GridPane.columnIndex="1">
                                <Label style="-fx-font-size: 9px; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-font-family: 'Segoe UI', system; -fx-letter-spacing: 0.8;" text="SALES PERFORMANCE" />
                                <Label style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #059669; -fx-font-family: 'Segoe UI', system;" text="12,450" />
                                <Label style="-fx-font-size: 8px; -fx-text-fill: #10b981; -fx-font-weight: 600; -fx-font-family: 'Segoe UI', system;" text="+12% this month" />
                            </VBox>

                            <rowConstraints>
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>

                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="55" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="45" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints percentHeight="35" vgrow="NEVER" />
                            <RowConstraints percentHeight="6" vgrow="NEVER" />
                            <RowConstraints percentHeight="59" vgrow="NEVER" />
                        </rowConstraints>
                    </GridPane>
                </StackPane>
            </children>
        </HBox>
    </children>
</StackPane>
