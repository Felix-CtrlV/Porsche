<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="320.0" spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e1e5e9;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 25;">
         <HBox.margin>
            <Insets left="15.0" />
         </HBox.margin>
      </ImageView>
      <VBox alignment="CENTER_LEFT" spacing="5">
         <children>
            <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 14;" text="John Smith" />
            <HBox spacing="20">
               <children>
                  <VBox spacing="2">
                     <children>
                        <Label style="-fx-text-fill: #2c3e50; -fx-font-size: 11; -fx-font-weight: bold;" text="WORK HOURS" />
                        <Label style="-fx-text-fill: #3498db; -fx-font-size: 13; -fx-font-weight: bold;" text="40 hrs" />
                     </children>
                  </VBox>
                  <VBox spacing="2">
                     <children>
                        <Label style="-fx-text-fill: #2c3e50; -fx-font-size: 11; -fx-font-weight: bold;" text="SALES" />
                        <Label style="-fx-text-fill: #27ae60; -fx-font-size: 13; -fx-font-weight: bold;" text="12,450" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
