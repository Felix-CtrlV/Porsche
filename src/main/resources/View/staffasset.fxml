<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane prefHeight="800" prefWidth="1200" styleClass="root-container" stylesheets="@../CSS/staffasset.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffassetController">

    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-container">
            <padding>
                <Insets bottom="15" left="35" right="35" top="15" />
            </padding>

            <Button fx:id="backButton" prefHeight="38.0" prefWidth="38.0" styleClass="back-button" text="←" />

            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label styleClass="page-title" text="Premium Accessories" />
                <Label styleClass="page-subtitle" text="Enhance your driving experience" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label styleClass="cart-label" text="Cart Items:" />
                <Label fx:id="cartCountLabel" styleClass="cart-count" text="0" />
                <Button fx:id="viewCartButton" styleClass="view-cart-button" text="VIEW CART" />
            </HBox>
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="25">
                <padding>
                    <Insets bottom="35" left="35" right="35" top="15" />
                </padding>

                <VBox spacing="12" styleClass="slider-section">
                    <Label styleClass="section-title" text="New Arrivals" />

                    <StackPane styleClass="slider-container">
                        <ImageView fx:id="sliderImage" fitHeight="300" fitWidth="1050" preserveRatio="true" styleClass="slider-image" />

                        <HBox fx:id="sliderIndicators" alignment="CENTER" spacing="8" StackPane.alignment="BOTTOM_CENTER">
                            <StackPane.margin>
                                <Insets bottom="15" />
                            </StackPane.margin>
                        </HBox>

                        <VBox alignment="BOTTOM_LEFT" StackPane.alignment="BOTTOM_LEFT">
                            <padding>
                                <Insets bottom="25" left="25" />
                            </padding>
                            <Label fx:id="sliderTitle" styleClass="slider-title" text="Premium Floor Mats" />
                            <Label fx:id="sliderDescription" styleClass="slider-description" text="Custom-fitted luxury floor mats" />
                        </VBox>
                    </StackPane>
                </VBox>

                <HBox alignment="CENTER" spacing="15" styleClass="filter-container">
                    <Label styleClass="filter-label" text="Category:" />
                    <ToggleButton fx:id="allCategoryButton" selected="true" styleClass="filter-button" text="ALL PRODUCTS">
                        <toggleGroup>
                            <ToggleGroup fx:id="categoryToggleGroup" />
                        </toggleGroup>
                    </ToggleButton>
                    <ToggleButton fx:id="accessoriesButton" styleClass="filter-button" text="CAR ACCESSORIES" toggleGroup="$categoryToggleGroup" />
                    <ToggleButton fx:id="equipmentButton" styleClass="filter-button" text="EQUIPMENT" toggleGroup="$categoryToggleGroup" />
                    <fx:define>
                        <ToggleGroup fx:id="categoryToggleGroup" />
                    </fx:define>
                </HBox>

                <VBox fx:id="productsContainer" spacing="15">
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <StackPane fx:id="cartModalOverlay" managed="false" styleClass="modal-overlay" visible="false">
        <StackPane onMouseClicked="#closeCartModal" styleClass="blur-background" />

        <VBox maxHeight="550" maxWidth="650" styleClass="cart-modal-card">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <HBox alignment="CENTER" spacing="10">
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label styleClass="cart-modal-title" text="Shopping Cart" />
                    <Label fx:id="cartItemCountLabel" styleClass="cart-item-count-modal" text="0 items" />
                </VBox>
                <Button fx:id="closeCartButton" onAction="#closeCartModal" styleClass="close-modal-button" text="✕" />
            </HBox>

            <Line endX="600" strokeWidth="2" styleClass="divider">
                <VBox.margin>
                    <Insets bottom="10" top="10" />
                </VBox.margin>
            </Line>

            <ScrollPane fitToWidth="true" styleClass="cart-items-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="cartItemsContainer" spacing="10" />
            </ScrollPane>

            <Line endX="600" strokeWidth="2" styleClass="divider">
                <VBox.margin>
                    <Insets bottom="10" top="15" />
                </VBox.margin>
            </Line>

            <VBox spacing="10" styleClass="price-summary-section">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label minWidth="90" styleClass="summary-label" text="Subtotal:" />
                    <Label fx:id="subtotalLabel" styleClass="summary-value" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label minWidth="90" styleClass="summary-label" text="Tax (8%):" />
                    <Label fx:id="taxLabelCart" styleClass="summary-value" text="0" />
                </HBox>
                <Line endX="600" strokeWidth="1" styleClass="thin-divider" />
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label minWidth="90" styleClass="total-label-modal" text="Total:" />
                    <Label fx:id="totalLabel" styleClass="total-value-modal" text="0" />
                </HBox>
            </VBox>

            <HBox alignment="CENTER" spacing="12">
                <VBox.margin>
                    <Insets top="20" />
                </VBox.margin>
                <Button fx:id="clearCartButton" minHeight="40" minWidth="150" styleClass="clear-cart-button" text="CLEAR CART" />
                <Button fx:id="checkoutButton" minHeight="40" minWidth="220" styleClass="checkout-button-modal" text="PROCEED TO CHECKOUT" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
