<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="850.0" prefWidth="1300.0" styleClass="root" stylesheets="@../CSS/staffasset.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffassetController">
    <VBox spacing="0" StackPane.alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <HBox styleClass="top-bar" HBox.hgrow="ALWAYS">
            <Button fx:id="backButton" styleClass="back-nav-accessories" text="← BACK" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="page-title-accessories" text="Accessories Catalog" HBox.hgrow="ALWAYS" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox styleClass="cart-section">
                <VBox alignment="CENTER" spacing="4">
                    <HBox.margin>
                        <Insets right="12" />
                    </HBox.margin>
                    <Label style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #999999;" text="CART" />
                    <Label fx:id="cartCountLabel" styleClass="cart-badge" text="0" />
                </VBox>
                <Button fx:id="viewCartButton" styleClass="view-cart-button" text="VIEW CART" />
            </HBox>
        </HBox>

        <HBox styleClass="filter-bar" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #999999; -fx-letter-spacing: 0.8px;" text="FILTER BY:">
                <HBox.margin>
                    <Insets right="16" />
                </HBox.margin>
            </Label>
            <ToggleButton fx:id="allCategoryButton" styleClass="category-toggle" text="ALL" />
            <ToggleButton fx:id="accessoriesButton" styleClass="category-toggle" text="ACCESSORIES" />
            <ToggleButton fx:id="equipmentButton" styleClass="category-toggle" text="EQUIPMENT" />
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="products-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
            <VBox fx:id="productsContainer" styleClass="products-container" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" />
        </ScrollPane>
    </VBox>

    <StackPane fx:id="cartModal" visible="false" styleClass="cart-modal-overlay">
        <VBox styleClass="cart-modal-container">
            <HBox styleClass="cart-modal-header">
                <Label text="Shopping Cart" styleClass="cart-modal-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="closeCartButton" styleClass="close-cart-button" text="×" />
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="cart-items-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <VBox fx:id="cartItemsContainer" styleClass="cart-items-container" />
            </ScrollPane>

            <VBox styleClass="cart-totals-container">
                <HBox styleClass="cart-total-row">
                    <Label text="Subtotal:" styleClass="cart-total-label" />
                    <Label fx:id="cartSubtotalLabel" text="0.00" styleClass="cart-total-value" />
                </HBox>
                <HBox styleClass="cart-total-row">
                    <Label text="Total:" styleClass="cart-total-label-total" />
                    <Label fx:id="cartTotalLabel" text="0.00" styleClass="cart-total-value-total" />
                </HBox>
            </VBox>

            <HBox styleClass="cart-modal-footer">
                <Button fx:id="continueShoppingButton" styleClass="continue-shopping-button" text="CONTINUE SHOPPING" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="checkoutButtonModal" styleClass="checkout-button-modal" text="CHECKOUT" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>