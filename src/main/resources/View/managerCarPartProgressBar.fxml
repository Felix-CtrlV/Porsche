<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="120.0" maxWidth="1.7976931348623157E308" minHeight="120.0" minWidth="300.0" styleClass="carPartCard" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.managerCarPartProgressBarController">
    <padding>
        <Insets bottom="20" left="25" right="25" top="20" />
    </padding>
    <children>
        <!-- Image Section on Left -->
        <StackPane prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
            <children>
                <ImageView fx:id="carImage" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);" />
            </children>
            <padding>
                <Insets right="15" />
            </padding>
        </StackPane>

        <!-- Content Section on Right -->
        <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
            <children>
                <!-- Name -->
                <Label fx:id="Name" styleClass="cardName" style="-fx-font-weight: bold; -fx-font-size: 16;" text="TOYOTA CAMRY" wrapText="true">
                    <font>
                        <Font name="System Bold" size="16" />
                    </font>
                </Label>
                
                <!-- Sold and Rank in one row -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label styleClass="cardLabel" style="-fx-font-size: 12;" text="Sold:" />
                        <Label fx:id="soldQty" styleClass="cardSold" style="-fx-font-weight: bold;" text="1,250">
                            <font>
                                <Font name="System Bold" size="14" />
                            </font>
                        </Label>
                    </HBox>
                    
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label styleClass="cardLabel" style="-fx-font-size: 12;" text="Rank:" />
                        <Label fx:id="rank" styleClass="cardRank" style="-fx-font-weight: bold;" text="#3">
                            <font>
                                <Font name="System Bold" size="14" />
                            </font>
                        </Label>
                    </HBox>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
