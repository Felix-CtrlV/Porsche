<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" minHeight="300.0" minWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.adminDashboardController">
    <children>
        <BorderPane fx:id="root" minHeight="768.0" minWidth="1366.0" styleClass="background_pane" >
            <center>
                <AnchorPane fx:id="admin_anc" minHeight="721.0" minWidth="1366.0" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
            </center>
            <top>
                <HBox alignment="CENTER_LEFT" minHeight="47.0" minWidth="1366.0" prefHeight="37.0" prefWidth="200.0" styleClass="glass_main" BorderPane.alignment="CENTER">
                    <children>
                        <ImageView fx:id="img" fitHeight="35.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Image/porsche_logo.png" />
                            </image>
                            <HBox.margin>
                                <Insets left="17.0" />
                            </HBox.margin>
                        </ImageView>
                        <Line endX="-100.0" endY="30.0" startX="-100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="5.0" />
                            </HBox.margin>
                        </Line>
                        <VBox alignment="CENTER_LEFT" prefHeight="39.0" prefWidth="67.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome" />
                                <Label fx:id="nameLbl" styleClass="selected_dash_font" text="Admin"  style = "-fx-font-family: 'Arial Black'; -fx-font-size: 14px;-fx-opacity: 0.70;-fx-font-weight: 700;"/>
                            </children>
                        </VBox>
                        <Region maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefHeight="35.0" prefWidth="323.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="overviewbtn" onAction="#clickOverview" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Overview" HBox.hgrow="NEVER">
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin></Button>
                        <Button fx:id="accountbtn" onAction="#clickAccount" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Account" HBox.hgrow="NEVER" />
                        <Button fx:id="ordersbtn" onAction="#clickOrders" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Orders" HBox.hgrow="NEVER">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin></Button>
                        <Region maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="360.0" HBox.hgrow="ALWAYS" />
                        <StackPane minWidth="88.0" HBox.hgrow="NEVER">
                            <children>
                                <Label fx:id="settingIcon" styleClass="settingIcon"  style = "-fx-font-size: 30;-fx-alignment: center;" prefHeight="34.0" prefWidth="33.0" text="⚙">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor></Label>
                            </children></StackPane>
                    </children>
                </HBox>
            </top>
        </BorderPane>
        <Pane fx:id="overlayPane" styleClass="overlayPane" opacity="0.5" prefHeight="200.0" prefWidth="200.0" visible="false" />
        <VBox fx:id="settingPane" styleClass="settingPane" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" translateX="420" StackPane.alignment="CENTER_RIGHT">
            <children>
                <!-- Header -->
                <HBox styleClass="header"  style = "-fx-padding: 25; -fx-background-radius: 20 0 0 0;" alignment="CENTER" minHeight="50.0" prefHeight="58.0" prefWidth="420.0" spacing="15.0">
                    <children>
                        <Label styleClass="settingTitle" prefHeight="51.0" prefWidth="132.0" text="⚙  Settings" />
                    </children>
                </HBox>
                
                <!-- Settings Content -->
                <VBox spacing="0.0" styleClass="settingContent" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Profile Section -->
                        <VBox spacing="15.0" styleClass="section" style = "-fx-padding: 20;-fx-background-radius: 12;">
                            <VBox.margin>
                                <Insets bottom="15.0" left="15.0" right="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="title"  text="ACCOUNT" />
                                
                                <HBox fx:id="optionProfile" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane styleClass="iconBorder" style=" -fx-background-radius: 12;" minHeight="48.0" minWidth="48.0" >
                                            <children>
                                                <Label styleClass="icon" style = "-fx-font-size: 22;" text="👤" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="textHeader" text="View Profile" style = " -fx-font-size: 15;-fx-font-weight: bold;" />
                                                <Label styleClass="textDetail"     style = "-fx-font-size: 12;" text="Manage your account details" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                                
                                <HBox fx:id="optionTarget" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" styleClass="iconBorder" style=" -fx-background-radius: 12;">
                                            <children>
                                                <Label styleClass="icon" style = "-fx-font-size: 22;" text="🎯" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="textHeader" text="Targets" style = " -fx-font-size: 15;-fx-font-weight: bold;" />
                                                <Label styleClass="textDetail" style = "-fx-font-size: 12;" text="Set and manage sales targets" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                                
                                <HBox fx:id="optionSalary" alignment="CENTER_LEFT" spacing="15.0"  styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" styleClass="iconBorder" style=" -fx-background-radius: 12;">
                                            <children>
                                                <Label styleClass="icon" style = "-fx-font-size: 22;" text="💰" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="textHeader" text="Salary Management" style = " -fx-font-size: 15;-fx-font-weight: bold;"/>
                                                <Label styleClass="textDetail"    style = "-fx-font-size: 12;" text="Manage month-end salary processing" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                            </children>
                        </VBox>
                        
                        <!-- Preferences Section -->
                        <VBox spacing="15.0" styleClass="section" style = "-fx-padding: 20;-fx-background-radius: 12;">
                            <VBox.margin>
                                <Insets bottom="15.0" left="15.0" right="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="title" text="PREFERENCES" />
                                
                                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" styleClass="iconBorder" style=" -fx-background-radius: 12;">
                                            <children>
                                                <Label fx:id="moon" style = "-fx-font-size: 22;" styleClass="icon" text="🌙" />
                                                <Label fx:id="sun" style = "-fx-font-size: 22;" styleClass="icon" text="🔆" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="textMode" styleClass="textHeader" text="Dark Mode" style = " -fx-font-size: 15;-fx-font-weight: bold;" />
                                                <Label styleClass="textDetail"    style = "-fx-font-size: 12;" text="Toggle dark/light theme" />
                                            </children>
                                        </VBox>
                                        <ToggleButton fx:id="Mode"  minWidth="52.0" prefHeight="28.0" prefWidth="52.0" styleClass="mode" >
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </ToggleButton>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        
                        <!-- Security Section -->
                        <VBox spacing="15.0" styleClass="section" style = "-fx-padding: 20;-fx-background-radius: 12;">
                            <VBox.margin>
                                <Insets bottom="15.0" left="15.0" right="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="title" text="SECURITY" />
                                
                                <HBox fx:id="optionChange" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" styleClass="iconBorder" style=" -fx-background-radius: 12;">
                                            <children>
                                                <Label styleClass="icon" style = "-fx-font-size: 22;" text="🔐" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="textHeader" text="Change Password" style = " -fx-font-size: 15;-fx-font-weight: bold;"/>
                                                <Label styleClass="textDetail"    style = "-fx-font-size: 12;" text="Update your password" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                
                <!-- Logout Button at Bottom -->
                <HBox alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 20;">
                    <children>
                        <Button fx:id="logoutbtn" onAction="#clickLogout" prefHeight="50.0" prefWidth="380.0" style="-fx-background-color: linear-gradient(to right, #C21E2B, #af1b27); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);" text="🚪  Logout">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
        
        <!-- Password Verification Overlay -->
        <VBox fx:id="passwordVerifyPane" alignment="CENTER" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" styleClass="glass_main" style=" -fx-background-radius: 20 0 0 20;" translateX="420" StackPane.alignment="CENTER_RIGHT">
            <children>
                <VBox alignment="CENTER" maxWidth="350.0" spacing="25.0" styleClass="section" style=" -fx-background-radius: 16; -fx-padding: 40;">
                    <children>
                        <!-- Lock Icon -->
                        <StackPane prefHeight="49.0" prefWidth="270.0" styleClass="iconBorder" style=" -fx-background-radius: 40;">
                            <children>
                                <Label prefHeight="43.0" prefWidth="40.0" styleClass="icon" style="-fx-font-size: 30; -fx-alignment: center;" text="🔐" />
                            </children>
                        </StackPane>
                        
                        <VBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label style="-fx-font-size: 22; -fx-font-weight: bold; " styleClass="textHeader"  text="Verify Your Identity" />
                                <Label style="-fx-font-size: 14; -fx-text-alignment: center; -fx-wrap-text: true;" styleClass="textDetail" text="Please enter your password to view your profile" textAlignment="CENTER" wrapText="true" />
                            </children>
                        </VBox>
                        
                        <!-- Password Field -->
                        <VBox spacing="10.0" style="-fx-pref-width: 300;">
                            <children>
                                <Label styleClass="textHeader" style="-fx-font-size: 13; -fx-font-weight: bold;" text="Password" />
                                <javafx.scene.control.PasswordField styleClass="textField" fx:id="verifyPasswordField" promptText="Enter your password" style=" -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-border-radius: 10; -fx-border-width: 1;" />
                                <Label fx:id="passwordErrorLabel" style="-fx-text-fill: #dc2626; -fx-font-size: 12;" text=" " visible="false" />
                            </children>
                        </VBox>
                        
                        <!-- Buttons -->
                        <HBox alignment="CENTER" spacing="12.0" style="-fx-pref-width: 300;">
                            <children>
                                <Button fx:id="cancelVerifyBtn" styleClass="cancelBtn" onAction="#onCancelVerify" prefHeight="45.0" prefWidth="140.0" style="  -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Cancel">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                                <Button fx:id="verifyPasswordBtn" styleClass="iconBorder" onAction="#onVerifyPassword" prefHeight="45.0" prefWidth="140.0" style=" -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Verify">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
        
        <!-- Profile View Pane -->
        <VBox fx:id="profilePane" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" styleClass="glass_main" style=" -fx-background-radius: 20 0 0 20;" translateX="420" visible="false" StackPane.alignment="CENTER_RIGHT">
            <children>
                <!-- Header with Back Button -->
                <HBox alignment="CENTER_LEFT" minHeight="45.0" prefHeight="53.0" prefWidth="420.0" spacing="15.0" styleClass="header" style=" -fx-padding: 20; -fx-background-radius: 20 0 0 0;">
                    <children>
                        <Label fx:id="backToSettingsBtn" styleClass="selected_dash_font" style="-fx-font-size: 24; -fx-cursor: hand;" text="‹">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <HBox.margin>
                        <Insets bottom="4.0" />
                     </HBox.margin>
                        </Label>
                        <Label prefHeight="44.0" styleClass="textHeader" prefWidth="317.0" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-font-family: 'Arial Black';" text="My Profile" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets bottom="4.0" />
                     </HBox.margin></Label>
                        <Label fx:id="editProfileBtn" styleClass="settingIcon" style="-fx-font-size: 20; -fx-cursor: hand;" text="✏" visible="true">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <HBox.margin>
                        <Insets bottom="4.0" />
                     </HBox.margin>
                        </Label>
                    </children>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
                </HBox>
                
                <!-- Profile Content -->
                <javafx.scene.control.ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0" styleClass="glass_main" style=" -fx-padding: 20;">
                            <children>
                                <!-- Profile Picture -->
                                <VBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <StackPane alignment="CENTER" prefHeight="130.0" prefWidth="130.0">
                                            <children>
                                                <Circle radius="65.0" styleClass="imageCircle" />
                                                <ImageView fx:id="pfImage" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="false" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 3);">
                                                    <image>
                                                        <Image url="@../Image/usericon.png" />
                                                    </image>
                                                    <clip>
                                                        <javafx.scene.shape.Circle centerX="60.0" centerY="60.0" radius="60.0" />
                                                    </clip>
                                                </ImageView>
                                                <VBox alignment="BOTTOM_RIGHT" prefHeight="130.0" prefWidth="130.0" spacing="10.0" StackPane.alignment="CENTER">
                                                    <children>
                                                        <Button fx:id="editProfilePhotoBtn" mnemonicParsing="false" onAction="#onEditProfileImage" prefHeight="36.0" prefWidth="36.0" styleClass="section" style=" -fx-background-radius: 18; -fx-cursor: hand;">
                                                            <graphic>
                                                                <Label style="-fx-text-fill: #667eea; -fx-font-size: 16;" text="✏" />
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </StackPane>
                                        <Label fx:id="profileName" styleClass="textHeader" style="-fx-font-size: 24; -fx-font-weight: bold;" text=" " />
                                    </children>
                                </VBox>
                                
                                <!-- Account Details Card -->
                                <VBox spacing="15.0" styleClass="section" style="-fx-padding: 20; -fx-background-radius: 12;">
                                    <children>
                                        <Label styleClass="textDetail" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-letter-spacing: 0.5;" text="ACCOUNT DETAILS" />
                                        
                                        <!-- Email -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 18; " styleClass="textDetail" text="📧" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Email" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="profileEmail" editable="false" styleClass="textField" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: transparent; " text=" " />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Phone -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label styleClass="textDetail" style="-fx-font-size: 18;" text="📱" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Phone" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="profilePhone" styleClass="textField" editable="false" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: transparent;" text=" " />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Address -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 18;" styleClass="textDetail" text="🏠" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Address" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="profileAddress" editable="false" styleClass="textField" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: transparent;" text=" " />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Date of Birth -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label styleClass="textDetail" style="-fx-font-size: 18;" text="🎂" />
                                                        <Label styleClass="textDetail" style="-fx-font-size: 13; -fx-font-weight: bold;" text="Date of Birth" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="profileDOB" styleClass="textHeader"  style="-fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14;" text="" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                
                                <!-- Action Buttons -->
                                <VBox spacing="12.0">
                                    <children>
                                        <Button fx:id="saveProfileBtn" onAction="#onSaveProfile" prefHeight="48.0" prefWidth="380.0" styleClass="iconBorder" style=" -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="💾  Save Changes" visible="false">
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </Button>
                                        <Button fx:id="changePasswordBtn" styleClass="changePasswordBtn" onAction="#showChangePasswordDialog" prefHeight="48.0" prefWidth="380.0" style=" -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-width: 2; -fx-border-radius: 10; -fx-cursor: hand;" text="🔐  Change Password">
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </javafx.scene.control.ScrollPane>
            </children>
        </VBox>
        
        <!-- Target Management Pane -->
        <VBox fx:id="targetPane" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" styleClass="glass_main" style=" -fx-background-radius: 20 0 0 20;" translateX="420" visible="false" StackPane.alignment="CENTER_RIGHT">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="40.0" prefHeight="53.0" prefWidth="420.0" spacing="15.0" styleClass="header" style=" -fx-padding: 15 25; -fx-background-radius: 20 0 0 0;">
                    <children>
                        <Label fx:id="backToSettingsFromTarget" styleClass="selected_dash_font" style="-fx-font-size: 24;  -fx-cursor: hand;" text="‹">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <HBox.margin>
                        <Insets bottom="6.0" />
                     </HBox.margin>
                        </Label>
                        <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-font-family: 'Areal Black';" styleClass="textHeader" text="🎯  Sales Targets" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets bottom="6.0" />
                     </HBox.margin></Label>
                    </children>
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
                </HBox>
                
                <!-- Target Content (will be loaded from adminTargetManagement.fxml) -->
                <javafx.scene.control.ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane fx:id="targetContentPane" style="-fx-padding: 20;">
                        </StackPane>
                    </content>
                </javafx.scene.control.ScrollPane>
            </children>
        </VBox>
        
        <!-- Salary Management Pane -->
        <VBox fx:id="salaryPane" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" styleClass="glass_main" style=" -fx-background-radius: 20 0 0 20; " translateX="420" visible="false" StackPane.alignment="CENTER_RIGHT">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="40.0" prefHeight="53.0" prefWidth="420.0" spacing="15.0" styleClass="header" style=" -fx-padding: 15 25; -fx-background-radius: 20 0 0 0;">
                    <children>
                        <Label fx:id="backToSettingsFromSalary" styleClass="selected_dash_font" style="-fx-font-size: 24; -fx-cursor: hand;" text="‹">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <HBox.margin>
                        <Insets bottom="5.0" />
                     </HBox.margin>
                        </Label>
                        <Label styleClass="textHeader" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-font-family: 'Arial Black';" text="💰  Salary Management" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets bottom="5.0" />
                     </HBox.margin></Label>
                    </children>
               <VBox.margin>
                  <Insets top="7.0" />
               </VBox.margin>
                </HBox>
                
                <!-- Salary Content (will be loaded from adminSalaryManagement.fxml) -->
                <StackPane fx:id="salaryContentPane" VBox.vgrow="ALWAYS">
                </StackPane>
            </children>
        </VBox>
        
        <!-- Toast Notification (top center) -->
        <HBox fx:id="toastNotification" alignment="CENTER_LEFT"  maxHeight="60.0" maxWidth="360.0" spacing="12.0" styleClass="section" style=" -fx-background-radius: 10; -fx-padding: 12 16; -fx-border-color: #e5e7eb; -fx-border-width: 2; -fx-border-radius: 10;" translateY="-100" visible="false" StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets top="60.0" />
            </StackPane.margin>
            <children>
                <StackPane minHeight="36.0" minWidth="36.0" style="-fx-background-color: #10b981; -fx-background-radius: 18;">
                    <children>
                        <Label fx:id="toastIcon" style="-fx-font-size: 18;" styleClass="textColor" text="✓" />
                    </children>
                </StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="toastTitle" style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textHeader" text="Success" />
                        <Label fx:id="toastMessage" style="-fx-font-size: 11;" styleClass="textDetail" text="Operation completed successfully" />
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <!-- Confirmation Dialog Overlay -->
        <Pane fx:id="confirmOverlay" styleClass="overlayPane" opacity="0.5" visible="false" />
        
        <!-- Confirmation Dialog (top center) -->
        <VBox fx:id="confirmDialog" alignment="CENTER" maxHeight="-Infinity" maxWidth="400.0" spacing="0.0" styleClass="section" style=" -fx-background-radius: 12; " translateY="-600.0" visible="false" StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets top="100.0" />
            </StackPane.margin>
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="57.0" prefHeight="57.0" spacing="12.0" styleClass="iconBorder" style=" -fx-background-radius: 12 12 0 0; -fx-padding: 15 20;">
                    <children>
                        <StackPane minHeight="40.0" minWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20;">
                            <children>
                                <Label fx:id="confirmIcon" style="-fx-font-size: 20; -fx-text-fill: white;"  text="⚠" />
                            </children>
                        </StackPane>
                        <Label fx:id="confirmTitle" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Confirm Action" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                
                <!-- Content -->
                <VBox fx:id="confirmContent" spacing="10.0" style="-fx-padding: 15;">
                    <children>
                        <Label fx:id="confirmMessage" styleClass="textDetail" style="-fx-font-size: 13; -fx-wrap-text: true;" text="Are you sure you want to proceed?" wrapText="true" />
                    </children>
                </VBox>
                
                <!-- Buttons -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 0 15 15 15;">
                    <children>
                        <Button fx:id="confirmCancelBtn" onAction="#onConfirmCancel" prefHeight="38.0" prefWidth="170.0" styleClass="resetBtn" style=" -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancel">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        <Button fx:id="confirmOkBtn" onAction="#onConfirmOk" prefHeight="38.0" prefWidth="170.0" styleClass="iconBorder" style=" -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Confirm">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
        
                                <!-- Change Password Dialog (slides from top) -->
        <VBox fx:id="changePasswordDialog" alignment="CENTER" maxHeight="-Infinity" maxWidth="400.0" spacing="0.0" styleClass="section" style=" -fx-background-radius: 12;" translateY="-700.0" visible="false">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="40.0" prefHeight="57.0" prefWidth="370.0" spacing="12.0" styleClass="iconBorder" style=" -fx-background-radius: 12 12 0 0; -fx-padding: 15 20;">
                    <children>
                        <StackPane minHeight="40.0" minWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20;">
                            <Label style="-fx-font-size: 20; -fx-text-fill: white;"  text="🔐" />
                        </StackPane>
                        <Label prefHeight="20.0" prefWidth="275.0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Change Password" HBox.hgrow="ALWAYS" />
                        <Label fx:id="closePasswordDialogBtn" onMouseClicked="#closePasswordDialog" style="-fx-font-size: 18; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Label>
                    </children>
                </HBox>
                
                                        <!-- Content Area -->
                <StackPane style="-fx-padding: 15;">
                    <!-- Step 1: Current Password -->
                    <VBox fx:id="passwordVerificationPane" alignment="CENTER" spacing="10.0" visible="true">
                        <VBox alignment="CENTER" spacing="3.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="textHeader" text="Step 1: Verify Current Password" />
                            <Label style="-fx-font-size: 11;-fx-text-alignment: center;" styleClass="textHeader" text="Enter your current password to proceed" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                        
                        <VBox spacing="6.0" style="-fx-max-width: 340;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: 600;" styleClass="textDetail" text="Current Password" />
                            <PasswordField fx:id="currentPasswordField" promptText="Enter your current password" styleClass="textField" style=" -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                        </VBox>
                        
                        <Button fx:id="verifyCurrentPasswordBtn" onAction="#onVerifyCurrentPassword" prefHeight="38.0" prefWidth="340.0" styleClass="iconBorder" style=" -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Verify &amp; Send OTP">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        <Label fx:id="passwordVerifyStatus" style="-fx-font-size: 12; -fx-text-alignment: center;" styleClass="textDetail" textAlignment="CENTER" wrapText="true" />
                    </VBox>
                    
                                            <!-- Step 2: OTP Verification -->
                    <VBox fx:id="otpVerificationPane" alignment="CENTER" spacing="10.0" visible="false">
                        <VBox alignment="CENTER" spacing="3.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="textHeader" text="Step 2: Verify OTP" />
                            <Label fx:id="otpEmailLabel" style="-fx-font-size: 11;  -fx-text-alignment: center;" styleClass="textDetail" text="Enter the 6-digit code sent to your email" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                        
                                                <VBox spacing="6.0" style="-fx-max-width: 340;">
                            <Label style="-fx-font-size: 11; -fx-font-weight: 600;" styleClass="textDetail" text="OTP Code" />
                            <TextField fx:id="otpField" promptText="Enter 6-digit OTP" styleClass="textField" style=" -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                        </VBox>
                        
                                                <Button fx:id="verifyOtpBtn" onAction="#onVerifyOTP" prefHeight="38.0" prefWidth="340.0" styleClass="iconBorder" style=" -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Verify OTP">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        
                                                <Button fx:id="resendOtpBtn" onAction="#onResendOTP" prefHeight="32.0" prefWidth="340.0" style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-font-size: 12; -fx-font-weight: 600; -fx-cursor: hand; -fx-underline: true;" text="Resend OTP">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        
                                                <Label fx:id="otpVerifyStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
                    </VBox>
                    
                                            <!-- Step 3: New Password -->
                    <VBox fx:id="newPasswordPane" alignment="CENTER" spacing="10.0" visible="false">
                        <VBox alignment="CENTER" spacing="3.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="textHeader" text="Step 3: Set New Password" />
                            <Label style="-fx-font-size: 11; -fx-text-alignment: center;" styleClass="textDetail" text="Create a strong password for your account" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                        
                                                <VBox spacing="8.0" style="-fx-max-width: 340;">
                            <VBox spacing="6.0">
                                <Label style="-fx-font-size: 11; -fx-font-weight: 600;" styleClass="textHeader" text="New Password" />
                                <PasswordField fx:id="newPasswordField" promptText="Enter new password" styleClass="textField" style=" -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;  -fx-border-radius: 8; -fx-border-width: 1.5;" />
                            </VBox>
                            
                                                    <VBox spacing="6.0">
                                <Label style="-fx-font-size: 11; -fx-font-weight: 600;" styleClass="textHeader" text="Confirm Password" />
                                <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" styleClass="textField" style="-fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;-fx-border-radius: 8; -fx-border-width: 1.5;" />
                            </VBox>
                        </VBox>
                        
                                                <Button fx:id="changePasswordBtn" onAction="#onSubmitPasswordChange" prefHeight="38.0" prefWidth="340.0" styleClass="iconBorder" style=" -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="✓ Change Password">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        
                                                <Label fx:id="changePasswordStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
                    </VBox>
                    
                                            <!-- Loading Indicator -->
                    <StackPane fx:id="passwordLoadingPane" style="-fx-background-color: rgba(255,255,255,0.95);" visible="false">
                        <VBox alignment="CENTER" spacing="10.0">
                            <ProgressIndicator prefHeight="40.0" prefWidth="40.0" style="-fx-progress-color: #667eea;" />
                            <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #667eea;" text="Processing..." />
                        </VBox>
                    </StackPane>
                </StackPane>
                
                                        <!-- Message Bar (Login notification style) -->
                <StackPane fx:id="passwordMessagePane" opacity="0" prefHeight="40.0" style="-fx-background-radius: 12 12 0 0; -fx-background-color: rgb(255, 60, 41); -fx-border-width: 2; -fx-border-radius: 12 12 0 0; -fx-border-color: rgb(255, 102, 40);" translateY="40">
                    <Label fx:id="passwordMessageLabel"  styleClass="selected_dash_font"   style = "-fx-font-family: 'Arial Black'; -fx-font-size: 14px;-fx-opacity: 0.70;-fx-font-weight: 700;"
                    stylesheets="@../CSS/admin_light_mode.css" text="Success!">
                        <padding>
                            <Insets bottom="3.0" />
                        </padding>
                    </Label>
                </StackPane>
            </children>
        </VBox>

        <!-- Security Lock Overlay -->
        <StackPane fx:id="securityLockOverlay" style="-fx-background-color: rgba(0, 0, 0, 0.85);" visible="false" StackPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 10); -fx-max-width: 1920;">
                <!-- Lock Icon with Animation -->
                <StackPane prefHeight="120.0" prefWidth="120.0" style="-fx-background-color: #C21E2B; -fx-background-radius: 60;">
                    <Label fx:id="lockIcon" style="-fx-font-size: 60; -fx-text-fill: white;" text="🔒" />
                </StackPane>
                
                <!-- Title and Message -->
                <VBox alignment="CENTER" spacing="15.0">
                    <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="Account Locked" />
                    <Label fx:id="lockMessage" style="-fx-font-size: 16; -fx-text-fill: #374151; -fx-text-alignment: center; -fx-wrap-text: true;" text="Your account has been temporarily locked due to multiple failed login attempts." textAlignment="CENTER" wrapText="true" />
                </VBox>
                
                <!-- Security Information -->
                <VBox spacing="15.0" style="-fx-background-color: #fef2f2; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 12;">
                    <HBox alignment="CENTER" spacing="10.0">
                        <Label style="-fx-font-size: 20; -fx-text-fill: #dc2626;" text="🚨" />
                        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="Security Alert" />
                    </HBox>
                    <VBox alignment="CENTER" spacing="8.0">
                        <Label style="-fx-font-size: 13; -fx-text-fill: #374151;" text="• 5 consecutive failed password attempts detected" />
                        <Label style="-fx-font-size: 13; -fx-text-fill: #374151;" text="• Account automatically locked for security" />
                        <Label style="-fx-font-size: 13; -fx-text-fill: #374151;" text="• Unlock email sent to your registered address" />
                        <Label style="-fx-font-size: 13; -fx-text-fill: #374151;" text="• System administrators have been notified" />
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </children>
</StackPane>
