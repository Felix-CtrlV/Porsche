                    </children>
                </HBox>
                
                <!-- Settings Content -->
                <VBox spacing="0.0" styleClass="settingContent" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Profile Section -->
                        <VBox spacing="15.0" style="-fx-padding: 20;-fx-background-radius: 12;" styleClass="section">
                            <VBox.margin>
                                <Insets bottom="15.0" left="15.0" right="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="title" text="ACCOUNT" />
                                
                                <HBox fx:id="optionProfile" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" style=" -fx-background-radius: 12;" styleClass="iconBorder">
                                            <children>
                                                <Label style="-fx-font-size: 22;" styleClass="icon" text="👤" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style=" -fx-font-size: 15;-fx-font-weight: bold;" styleClass="textHeader" text="View Profile" />
                                                <Label style="-fx-font-size: 12;" styleClass="textDetail" text="Manage your account details" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                                
                                <HBox fx:id="optionTarget" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" style=" -fx-background-radius: 12;" styleClass="iconBorder">
                                            <children>
                                                <Label style="-fx-font-size: 22;" styleClass="icon" text="🎯" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style=" -fx-font-size: 15;-fx-font-weight: bold;" styleClass="textHeader" text="Targets" />
                                                <Label style="-fx-font-size: 12;" styleClass="textDetail" text="Set and manage sales targets" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                                
                                <HBox fx:id="optionSalary" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" style=" -fx-background-radius: 12;" styleClass="iconBorder">
                                            <children>
                                                <Label style="-fx-font-size: 22;" styleClass="icon" text="💰" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style=" -fx-font-size: 15;-fx-font-weight: bold;" styleClass="textHeader" text="Salary Management" />
                                                <Label style="-fx-font-size: 12;" styleClass="textDetail" text="Manage month-end salary processing" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                            </children>
                        </VBox>
                        
                        <!-- Preferences Section -->
                        <VBox spacing="15.0" style="-fx-padding: 20;-fx-background-radius: 12;" styleClass="section">
                            <VBox.margin>
                                <Insets bottom="15.0" left="15.0" right="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="title" text="PREFERENCES" />
                                
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#lightDarkToggle" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" style=" -fx-background-radius: 12;" styleClass="iconBorder">
                                            <children>
                                                <Label fx:id="moon" style="-fx-font-size: 22;" styleClass="icon" text="🌙" />
                                                <Label fx:id="sun" style="-fx-font-size: 22;" styleClass="icon" text="🔆" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="textMode" style=" -fx-font-size: 15;-fx-font-weight: bold;" styleClass="textHeader" text="Dark Mode" />
                                                <Label style="-fx-font-size: 12;" styleClass="textDetail" text="Toggle dark/light theme" />
                                            </children>
                                        </VBox>
                                        <StackPane minWidth="52.0" prefHeight="48.0" prefWidth="52.0">
                                            <ToggleButton fx:id="Mode" minWidth="52.0" prefHeight="28.0" prefWidth="89.0" styleClass="mode">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </ToggleButton>
                                            <Circle fx:id="toggleCircle" radius="13" strokeWidth="5" styleClass="toggleCircle" StackPane.alignment="CENTER_LEFT" />
                                        </StackPane>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        
                        <!-- Security Section -->
                        <VBox spacing="15.0" style="-fx-padding: 20;-fx-background-radius: 12;" styleClass="section">
                            <VBox.margin>
                                <Insets bottom="15.0" left="15.0" right="15.0" />
                            </VBox.margin>
                            <children>
                                <Label styleClass="title" text="SECURITY" />
                                
                                <HBox fx:id="optionChange" alignment="CENTER_LEFT" spacing="15.0" styleClass="settings-item-hover">
                                    <children>
                                        <StackPane minHeight="48.0" minWidth="48.0" style=" -fx-background-radius: 12;" styleClass="iconBorder">
                                            <children>
                                                <Label style="-fx-font-size: 22;" styleClass="icon" text="🔐" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style=" -fx-font-size: 15;-fx-font-weight: bold;" styleClass="textHeader" text="Change Password" />
                                                <Label style="-fx-font-size: 12;" styleClass="textDetail" text="Update your password" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="textPointer" text="›" />
                                    </children>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                
                <!-- Logout Button at Bottom -->
                <HBox alignment="CENTER" style=" -fx-padding: 20;" styleClass="section">
                    <children>
                        <Button fx:id="logoutbtn" onAction="#clickLogout" prefHeight="50.0" prefWidth="380.0" style="-fx-background-color: linear-gradient(to right, #C21E2B, #af1b27); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);" text="🚪  Logout">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
        
        <!-- Password Verification Overlay -->
        <VBox fx:id="passwordVerifyPane" alignment="CENTER" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" style=" -fx-background-radius: 20 0 0 20;" styleClass="glass_main" translateX="420" visible="false" StackPane.alignment="CENTER_RIGHT">
            <children>
                <VBox alignment="CENTER" maxWidth="350.0" spacing="25.0" style=" -fx-background-radius: 16; -fx-padding: 40;" styleClass="section">
                    <children>
                        <!-- Lock Icon -->
                        <StackPane prefHeight="49.0" prefWidth="270.0" style=" -fx-background-radius: 40;" styleClass="iconBorder">
                            <children>
                                <Label prefHeight="43.0" prefWidth="40.0" style="-fx-font-size: 30; -fx-alignment: center;" styleClass="icon" text="🔐" />
                            </children>
