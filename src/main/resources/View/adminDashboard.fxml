                                <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textHeader" text="Password" />
                                <javafx.scene.control.PasswordField fx:id="verifyPasswordField" promptText="Enter your password" style=" -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-border-radius: 10; -fx-border-width: 1;" styleClass="textField" />
                                <Label fx:id="passwordErrorLabel" style="-fx-text-fill: #dc2626; -fx-font-size: 12;" text=" " visible="false" />
                            </children>
                        </VBox>
                        
                        <!-- Buttons -->
                        <HBox alignment="CENTER" spacing="12.0" style="-fx-pref-width: 300;">
                            <children>
                                <Button fx:id="cancelVerifyBtn" onAction="#onCancelVerify" prefHeight="45.0" prefWidth="140.0" style="  -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" styleClass="cancelBtn" text="Cancel">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                                <Button fx:id="verifyPasswordBtn" onAction="#onVerifyPassword" prefHeight="45.0" prefWidth="140.0" style=" -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" styleClass="iconBorder" text="Verify">
