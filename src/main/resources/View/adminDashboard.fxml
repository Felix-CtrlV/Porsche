            </children>
        </VBox>
        
        <!-- Target Management Pane -->
        <VBox fx:id="targetPane" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" style=" -fx-background-radius: 20 0 0 20;" styleClass="glass_main" translateX="420" visible="false" StackPane.alignment="CENTER_RIGHT">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" minHeight="40.0" prefHeight="53.0" prefWidth="420.0" spacing="15.0" style=" -fx-padding: 15 25; -fx-background-radius: 20 0 0 0;" styleClass="header">
                    <children>
                        <Label fx:id="backToSettingsFromTarget" style="-fx-font-size: 24;  -fx-cursor: hand;" styleClass="selected_dash_font" text="‹">
                            <cursor>
                                <Cursor fx:constant="HAND" />
