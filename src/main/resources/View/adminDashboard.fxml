<StackPane fx:id="rootPane" minHeight="300.0" minWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.adminDashboardController">
    <children>
        <BorderPane fx:id="root" minHeight="768.0" minWidth="1366.0" styleClass="background_pane">
            <center>
                <AnchorPane fx:id="admin_anc" minHeight="721.0" minWidth="1366.0" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
            </center>
            <top>
                <HBox alignment="CENTER_LEFT" minHeight="47.0" minWidth="1366.0" prefHeight="37.0" prefWidth="200.0" style="-fx-background-insets: 0, 0; -fx-background-radius: 0 0 15 15; -fx-border-width: 1; -fx-border-radius: 0 0 15 15;" styleClass="glass_main" BorderPane.alignment="CENTER">
                    <children>
                        <ImageView fx:id="img" fitHeight="35.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Image/porsche_logo.png" />
                            </image>
                            <HBox.margin>
                                <Insets left="17.0" />
                            </HBox.margin>
                        </ImageView>
                        <Line endX="-100.0" endY="30.0" startX="-100.0">
                            <HBox.margin>
                                <Insets left="5.0" right="5.0" />
                            </HBox.margin>
                        </Line>
                        <VBox alignment="CENTER_LEFT" prefHeight="39.0" prefWidth="67.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-opacity:0.7;-fx-font-weight:700; -fx-font-family:'Arial Black'; " styleClass="textHeader" text="Welcome" />
                                <Label fx:id="nameLbl" style="-fx-font-family: 'Arial Black'; -fx-font-size: 14px;-fx-opacity: 0.70;-fx-font-weight: 700;" styleClass="selected_dash_font" text="Admin" />
                            </children>
                        </VBox>
                        <Region maxWidth="Infinity" minHeight="0.0" minWidth="0.0" prefHeight="35.0" prefWidth="323.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="overviewbtn" onAction="#clickOverview" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Overview" HBox.hgrow="NEVER">
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin></Button>
                        <Button fx:id="accountbtn" onAction="#clickAccount" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Account" HBox.hgrow="NEVER" />
                        <Button fx:id="ordersbtn" onAction="#clickOrders" prefHeight="24.0" prefWidth="88.0" styleClass="navbtn" text="Orders" HBox.hgrow="NEVER">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin></Button>
                        <Region maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="360.0" HBox.hgrow="ALWAYS" />
                        <StackPane minWidth="88.0" HBox.hgrow="NEVER">
                            <children>
                                <Label fx:id="settingIcon" prefHeight="34.0" prefWidth="33.0" style="-fx-font-size: 30;-fx-alignment: center;" styleClass="settingIcon" text="⚙">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor></Label>
                            </children></StackPane>
                    </children>
                </HBox>
            </top>
        </BorderPane>
        <Pane fx:id="overlayPane" opacity="0.5" prefHeight="200.0" prefWidth="200.0" styleClass="overlayPane" visible="false" />
