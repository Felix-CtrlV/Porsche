                                            </cursor>
                                        </Button>
                                        <Button fx:id="changePasswordBtn" onAction="#showChangePasswordDialog" prefHeight="48.0" prefWidth="380.0" style=" -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-width: 2; -fx-border-radius: 10; -fx-cursor: hand;" styleClass="changePasswordBtn" text="🔐  Change Password">
