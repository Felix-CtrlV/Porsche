                                                                <Label style="-fx-text-fill: #667eea; -fx-font-size: 16;" text="✏" />
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </StackPane>
                                        <Label fx:id="profileName" style="-fx-font-size: 24; -fx-font-weight: bold;" styleClass="textHeader" text=" " />
                                    </children>
                                </VBox>
                                
                                <!-- Account Details Card -->
                                <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-radius: 12;" styleClass="section">
                                    <children>
                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-letter-spacing: 0.5;" styleClass="textDetail" text="ACCOUNT DETAILS" />
                                        
                                        <!-- Email -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 18; " styleClass="textDetail" text="📧" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Email" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="profileEmail" editable="false" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: transparent; " styleClass="textField" text=" " />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Phone -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 18;" styleClass="textDetail" text="📱" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Phone" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="profilePhone" editable="false" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: transparent;" styleClass="textField" text=" " />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Address -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 18;" styleClass="textDetail" text="🏠" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Address" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="profileAddress" editable="false" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: transparent;" styleClass="textField" text=" " />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Date of Birth -->
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 18;" styleClass="textDetail" text="🎂" />
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" styleClass="textDetail" text="Date of Birth" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="profileDOB" style=" -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14;" styleClass="labelStyle" text="" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                
                                <!-- Action Buttons -->
                                <VBox spacing="12.0">
                                    <children>
                                        <Button fx:id="saveProfileBtn" onAction="#onSaveProfile" prefHeight="48.0" prefWidth="380.0" style=" -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" styleClass="iconBorder" text="💾  Save Changes" visible="false">
