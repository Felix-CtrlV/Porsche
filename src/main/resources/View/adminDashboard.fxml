                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </Button>
                                        <Button fx:id="selfTerminateBtn" onAction="#onSelfTerminateClick" prefHeight="48.0" prefWidth="380.0" style=" -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-background-color: #dc2626; -fx-text-fill: white; -fx-cursor: hand;" text="🚪  Self Terminate">
