                    </children>
                </VBox>
            </children>
        </VBox>
        
        <!-- Profile View Pane -->
        <VBox fx:id="profilePane" maxWidth="420.0" prefHeight="580.0" prefWidth="420.0" style=" -fx-background-radius: 20 0 0 20;" styleClass="glass_main" translateX="420" visible="false" StackPane.alignment="CENTER_RIGHT">
