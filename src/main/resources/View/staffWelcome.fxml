<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="580.0" prefWidth="1188.0" stylesheets="@../CSS/DashBoard_general.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffWelcomeController">

    <!-- Bottom Bar -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="50.0" spacing="50.0" style="-fx-background-color: black;">
            <children>
                <Line endX="499.2929" stroke="WHITE" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="5.0" />
                    </HBox.margin>
                </Line>
                <Label text="GT3" textFill="WHITE">
                    <font>
                        <Font name="Bookman Old Style" size="13.0" />
                    </font>
                </Label>
                <Label text="Dakar" textFill="WHITE">
                    <font>
                        <Font name="Bookman Old Style" size="13.0" />
                    </font>
                </Label>
                <Label text="Special 70s" textFill="WHITE">
                    <font>
                        <Font name="Bookman Old Style" size="13.0" />
                    </font>
                </Label>
                <Label text="Turbo S" textFill="WHITE">
                    <font>
                        <Font name="Bookman Old Style" size="13.0" />
                    </font>
                </Label>
                <Line endX="100.0" stroke="#f2f2f2" HBox.hgrow="SOMETIMES" />
            </children>
        </HBox>
    </bottom>

    <!-- Left Panel -->
    <left>
        <StackPane prefWidth="341.0">
            <children>
                <VBox fx:id="vbox" prefWidth="334.0" style="-fx-background-color: black;">
                    <children>
                        <HBox alignment="CENTER" prefHeight="40.0">
                            <children>
                                <ImageView fitHeight="38.0" fitWidth="34.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../Image/porsche_logo.png" />
                                    </image>
                                </ImageView>
                                <Region prefWidth="232.0" />
                                <Button fx:id="logoutbtn" onAction="#logout" styleClass="setbtn" text="⚙" />
                            </children>
                            <padding>
                                <Insets top="10.0" />
                            </padding>
                        </HBox>

                        <Region prefHeight="68.0" />

                        <Label fx:id="topicLabel" styleClass="topic_font" text="718 Dakar Edition" textFill="WHITE">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </Label>

                        <Label fx:id="headingLabel" styleClass="heading" text="No Substitute" textFill="WHITE">
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </Label>

                        <Button fx:id="discoverbtn" onAction="#discover" prefWidth="146.0" styleClass="square-button" text="Discover more">
                            <VBox.margin>
                                <Insets bottom="10.0" left="15.0" top="10.0" />
                            </VBox.margin>
                        </Button>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Looking for :" textFill="WHITE" />
                                <Button styleClass="transparent-button" text="Accessories" />
                            </children>
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </HBox>

                        <Region prefHeight="73.0" />

                        <Line endX="94.5" stroke="WHITE" style="-fx-opacity: 0.6;">
                            <VBox.margin>
                                <Insets left="15.0" />
                            </VBox.margin>
                        </Line>

                        <Label text="Porsche is built with unmatched precision and passion.&#10;Every detail reflects timeless craftsmanship and innovation.&#10;The result: pure perfection in motion" textFill="WHITE" wrapText="true">
                            <VBox.margin>
                                <Insets left="15.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </left>

    <!-- Right Image -->
    <right>
        <StackPane fx:id="imageContainer">
            <children>
                <ImageView fx:id="backgroundImage" fitHeight="533.0" fitWidth="848.0" preserveRatio="false">
               <image>
                  <Image url="@../Image/startUpImage.png" />
               </image></ImageView>
            </children>
        </StackPane>
    </right>

</BorderPane>
