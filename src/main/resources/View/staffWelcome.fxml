<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="1133.0" prefHeight="580.0"
            stylesheets="@../CSS/DashBoard_general.css"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.staffWelcomeController"
            styleClass="root-pane">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" style="-fx-background-color: black;" prefHeight="60.0" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <children>
            <ImageView fitHeight="40" fitWidth="36" preserveRatio="true">
                <image><Image url="@../Image/porsche_logo.png"/></image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutbtn" onAction="#togglePopup" styleClass="setbtn" text="⚙" />
        </children>
        <padding><Insets left="15" right="15" top="10" bottom="10"/></padding>
    </HBox>

    <!-- LEFT INFO PANEL -->
    <VBox fx:id="vbox" style="-fx-background-color: black;" spacing="15"
          prefWidth="350" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0">
        <children>
            <Region prefHeight="20"/>
            <Label fx:id="topicLabel" styleClass="topic_font" text="718 Dakar Edition" textFill="WHITE">
                <padding><Insets left="20.0"/></padding>
            </Label>
            <Label fx:id="headingLabel" styleClass="heading" text="No Substitute" textFill="WHITE">
                <padding><Insets left="20.0"/></padding>
            </Label>
            <Button fx:id="discoverbtn" onAction="#discover" text="Discover More" styleClass="square-button" prefWidth="160">
                <VBox.margin><Insets left="20.0"/></VBox.margin>
            </Button>

            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label text="Looking for:" textFill="WHITE"/>
                    <Button fx:id="accessorybtn" onAction="#clickaccessorybtn" styleClass="transparent-button" text="Accessories"/>
                </children>
                <padding><Insets left="20"/></padding>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Line endX="100" stroke="WHITE" style="-fx-opacity:0.5;">
                <VBox.margin><Insets left="20"/></VBox.margin>
            </Line>

            <Label text="Porsche is built with unmatched precision and passion.&#10;Every detail reflects timeless craftsmanship and innovation.&#10;The result: pure perfection in motion"
                   wrapText="true" textFill="WHITE">
                <padding><Insets left="20" right="15"/></padding>
            </Label>
        </children>
    </VBox>

    <!-- RIGHT IMAGE PANEL -->
    <StackPane fx:id="imageContainer" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="350.0" AnchorPane.rightAnchor="0.0">
        <children>
            <ImageView fx:id="backgroundImage" preserveRatio="false">
                <image><Image url="@../Image/startUpImage.png"/></image>
            </ImageView>
        </children>
    </StackPane>

    <!-- FOOTER -->
    <HBox alignment="CENTER" spacing="50" style="-fx-background-color: black;" prefHeight="50" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <children>
            <Line endX="400" stroke="WHITE" HBox.hgrow="ALWAYS">
                <HBox.margin><Insets left="10"/></HBox.margin>
            </Line>
            <Label text="GT3" textFill="WHITE">
                <font><Font name="Bookman Old Style" size="13"/></font>
            </Label>
            <Label text="Dakar" textFill="WHITE">
                <font><Font name="Bookman Old Style" size="13"/></font>
            </Label>
            <Label text="Special 70s" textFill="WHITE">
                <font><Font name="Bookman Old Style" size="13"/></font>
            </Label>
            <Label text="Turbo S" textFill="WHITE">
                <font><Font name="Bookman Old Style" size="13"/></font>
            </Label>
            <Line endX="100" stroke="#f2f2f2" HBox.hgrow="SOMETIMES"/>
        </children>
    </HBox>

    <!-- SETTINGS POPUP -->
    <VBox fx:id="settingsPopup" visible="false" managed="false"
          alignment="CENTER_LEFT"
          style="-fx-background-color: #222; -fx-background-radius: 10; -fx-border-color: #555; -fx-border-radius: 10;"
          prefWidth="180" layoutX="200" layoutY="70">
        <children>
            <Button text="Profile View" onAction="#viewProfile"
                    style="-fx-text-fill: white; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button text="Change Password" onAction="#changePassword"
                    style="-fx-text-fill: white; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button text="Logout" onAction="#logout"
                    style="-fx-text-fill: white; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
        </children>
        <padding><Insets top="10" left="15" bottom="10" right="15"/></padding>
    </VBox>

</AnchorPane>
