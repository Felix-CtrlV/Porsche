<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="rootPane" maxHeight="580.0" maxWidth="1188.0" minHeight="580.0" minWidth="1188.0"
            prefHeight="580.0" prefWidth="1188.0" style="-fx-background-color: black;"
            stylesheets="@../CSS/DashBoard_general.css"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.staffWelcomeController">

    <StackPane fx:id="contentPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <VBox fx:id="mainContent" style="-fx-background-color: black;">
                <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: black;">
                        <children>
                            <ImageView fitHeight="40" fitWidth="36" preserveRatio="true">
                                <image>
                                    <Image url="@../Image/porsche_logo.png" />
                                </image>
                            </ImageView>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="settingsButton" style="-fx-background-color: transparent; -fx-cursor: hand;
                                    -fx-text-fill: white; -fx-font-size: 20; -fx-padding: 8 8 8 8;"
                                    text="⚙"
                                    onMouseClicked="#toggleProfileMenu"
                                    onMouseEntered="#onSettingsButtonEntered"
                                    onMouseExited="#onSettingsButtonExited" />
                        </children>
                        <padding>
                            <Insets bottom="10" left="15" right="15" top="10" />
                        </padding>
                    </HBox>

                    <HBox prefHeight="520.0" style="-fx-background-color: black;">
                        <children>
                            <VBox fx:id="vbox" prefWidth="350" spacing="15" style="-fx-background-color: black;">
                                <children>
                                    <Region prefHeight="20" />
                                    <Label fx:id="topicLabel" styleClass="topic_font" text="PORSCHE" textFill="WHITE">
                                        <padding>
                                            <Insets left="20.0" />
                                        </padding>
                                    </Label>
                                    <Label fx:id="headingLabel" styleClass="heading" text="No Substitute" textFill="WHITE">
                                        <padding>
                                            <Insets left="20.0" />
                                        </padding>
                                    </Label>
                                    <Button fx:id="discoverbtn" onAction="#discover" prefWidth="160"
                                            styleClass="square-button" text="View Models">
                                        <VBox.margin>
                                            <Insets left="20.0" />
                                        </VBox.margin>
                                    </Button>

                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label text="Looking for:" textFill="WHITE" />
                                            <Button fx:id="accessorybtn" onAction="#clickaccessorybtn"
                                                    styleClass="transparent-button" text="Accessories" />
                                        </children>
                                        <padding>
                                            <Insets left="20" />
                                        </padding>
                                    </HBox>

                                    <Region VBox.vgrow="ALWAYS" />

                                    <Line endX="100" stroke="WHITE" style="-fx-opacity:0.5;">
                                        <VBox.margin>
                                            <Insets left="20" />
                                        </VBox.margin>
                                    </Line>

                                    <Label text="Porsche is built with unmatched precision and passion.&#10;Every detail reflects timeless craftsmanship and innovation.&#10;The result: pure perfection in motion"
                                           textFill="WHITE" wrapText="true">
                                        <padding>
                                            <Insets left="20" right="15" />
                                        </padding>
                                    </Label>
                                </children>
                            </VBox>

                            <StackPane fx:id="imageContainer" styleClass="bg-img-pane" HBox.hgrow="ALWAYS">
                                <children>
                                    <ImageView fx:id="backgroundImage" fitHeight="470.0" fitWidth="838.0"
                                               preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../Image/startUpImage.png" />
                                        </image>
                                    </ImageView>
                                </children>
                            </StackPane>
                        </children>
                    </HBox>

                    <HBox alignment="CENTER" prefHeight="50" spacing="50" style="-fx-background-color: black;">
                        <children>
                            <Line endX="400" stroke="WHITE" HBox.hgrow="ALWAYS">
                                <HBox.margin>
                                    <Insets left="10" />
                                </HBox.margin>
                            </Line>
                            <Label text="GT3" textFill="WHITE">
                                <font>
                                    <Font name="Bookman Old Style" size="13" />
                                </font>
                            </Label>
                            <Label text="Dakar" textFill="WHITE">
                                <font>
                                    <Font name="Bookman Old Style" size="13" />
                                </font>
                            </Label>
                            <Label text="Special 70s" textFill="WHITE">
                                <font>
                                    <Font name="Bookman Old Style" size="13" />
                                </font>
                            </Label>
                            <Label text="Turbo S" textFill="WHITE">
                                <font>
                                    <Font name="Bookman Old Style" size="13" />
                                </font>
                            </Label>
                            <Line endX="100" stroke="#f2f2f2" HBox.hgrow="SOMETIMES" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </StackPane>

    <VBox fx:id="settingsPopup" alignment="CENTER_LEFT"
          layoutX="1000.0" layoutY="65.0"
          managed="false" visible="false"
          prefWidth="200"
          style="-fx-background-color: #222; -fx-background-radius: 10;
                 -fx-border-color: #555; -fx-border-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 2);"
          AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="65.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15 15 10 15;">
                <children>
                    <StackPane>
                        <ImageView fx:id="profilePictureView" fitHeight="40" fitWidth="40" preserveRatio="true">
                            <image>
                                <Image url="@../Image/usericon.png" />
                            </image>
                            <clip>
                                <Circle radius="20" centerX="20" centerY="20" />
                            </clip>
                        </ImageView>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" />
                        <Label fx:id="userRoleLabel" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11;" />
                    </VBox>
                </children>
            </HBox>

            <Line endX="180" stroke="#555" strokeWidth="1" />

            <Button onAction="#handleChangePassword"
                    style="-fx-text-fill: white; -fx-background-color: transparent;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;
                           -fx-cursor: hand; -fx-background-radius: 5;"
                    text="Change Password" />
            <Button onAction="#handleChangeProfilePicture"
                    style="-fx-text-fill: white; -fx-background-color: transparent;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;
                           -fx-cursor: hand; -fx-background-radius: 5;"
                    text="Change Profile Picture" />
            <Button onAction="#handlePaymentDetails"
                    style="-fx-text-fill: white; -fx-background-color: transparent;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;
                           -fx-cursor: hand; -fx-background-radius: 5;"
                    text="Payment Details" />
            <Line endX="180" stroke="#555" strokeWidth="1" />
            <Button onAction="#logout"
                    style="-fx-text-fill: #ff4444; -fx-background-color: transparent;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;
                           -fx-cursor: hand; -fx-background-radius: 5;"
                    text="Logout" />
        </children>
    </VBox>

    <VBox fx:id="paymentPopup" alignment="CENTER" styleClass="payment-popup"
          managed="false" visible="false"
          prefWidth="800" prefHeight="500"
          AnchorPane.topAnchor="40.0" AnchorPane.bottomAnchor="40.0"
          AnchorPane.leftAnchor="194.0" AnchorPane.rightAnchor="194.0">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Payment Management" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefreshPayments"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15;"/>
            <Button text="Close" onAction="#handleClosePayments"
                    style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15;"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER">
            <VBox styleClass="payment-stat-card" spacing="5" prefWidth="120">
                <Label text="Pending" styleClass="payment-stat-pending" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                <Label fx:id="paymentPendingCount" text="0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            </VBox>

            <VBox styleClass="payment-stat-card" spacing="5" prefWidth="120">
                <Label text="Overdue" styleClass="payment-stat-overdue" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                <Label fx:id="paymentOverdueCount" text="0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            </VBox>

            <VBox styleClass="payment-stat-card" spacing="5" prefWidth="120">
                <Label text="Paid" styleClass="payment-stat-paid" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                <Label fx:id="paymentPaidCount" text="0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Search:" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <TextField fx:id="paymentSearchField" promptText="Search by Order ID or Installment..."
                       style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-border-color: #555; -fx-pref-width: 250;"/>

            <Label text="Status:" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <ComboBox fx:id="paymentStatusFilter" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-pref-width: 120;"/>
        </HBox>

        <TableView fx:id="paymentTable" styleClass="payment-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colInstallmentId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="80"/>
                <TableColumn fx:id="colInstallmentNumber" text="Installment #" prefWidth="100"/>
                <TableColumn fx:id="colDueDate" text="Due Date" prefWidth="100"/>
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="80"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label text="Click 'Pay' button to process installment payments. Green status indicates paid, orange indicates pending, red indicates overdue."
               style="-fx-text-fill: #ccc; -fx-font-size: 12; -fx-wrap-text: true;"/>
    </VBox>

    <VBox fx:id="passwordVerifyPane" alignment="CENTER" spacing="20"
          managed="false" visible="false"
          prefWidth="350" prefHeight="250"
          style="-fx-background-color: #1a1a1a; -fx-background-radius: 15;
                 -fx-border-color: #333; -fx-border-radius: 15;
                 -fx-border-width: 2; -fx-padding: 30;"
          AnchorPane.topAnchor="165.0" AnchorPane.bottomAnchor="165.0"
          AnchorPane.leftAnchor="419.0" AnchorPane.rightAnchor="419.0">

        <Label text="Security Verification"
               style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

        <Label text="Please enter your password to continue"
               style="-fx-text-fill: #ccc; -fx-font-size: 12;"/>

        <VBox spacing="10" alignment="CENTER">
            <PasswordField fx:id="verifyPasswordField"
                           promptText="Enter your password"
                           style="-fx-background-color: #2a2a2a; -fx-text-fill: white;
                                 -fx-border-color: #555; -fx-pref-width: 250;
                                 -fx-background-radius: 8; -fx-border-radius: 8;"/>

            <Label fx:id="passwordErrorLabel"
                   style="-fx-text-fill: #ff4444; -fx-font-size: 11;"
                   visible="false"/>
        </VBox>

        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="cancelVerifyBtn" text="Cancel"
                    style="-fx-background-color: #666; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 8 20 8 20;
                           -fx-background-radius: 8;"/>

            <Button fx:id="verifyPasswordBtn" text="Verify"
                    style="-fx-background-color: #ff4444; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 8 20 8 20;
                           -fx-background-radius: 8;"/>
        </HBox>
    </VBox>

    <StackPane fx:id="securityLockOverlay" alignment="CENTER"
               managed="false" visible="false"
               style="-fx-background-color: rgba(0,0,0,0.8);"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: #1a1a1a; -fx-background-radius: 15;
                     -fx-border-color: #ff4444; -fx-border-radius: 15;
                     -fx-border-width: 2; -fx-padding: 40;"
              prefWidth="400" prefHeight="300">

            <Label fx:id="lockIcon" text="🔒"
                   style="-fx-font-size: 48;"/>

            <Label text="Account Temporarily Locked"
                   style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

            <Label fx:id="lockMessage" wrapText="true"
                   style="-fx-text-fill: #ccc; -fx-font-size: 14; -fx-alignment: center;"
                   maxWidth="350"/>

            <Label text="Please check your email for unlock instructions"
                   style="-fx-text-fill: #ff4444; -fx-font-size: 12; -fx-font-weight: bold;"/>
        </VBox>
    </StackPane>

    <StackPane fx:id="securityAlertOverlay"
               styleClass="security-popup-overlay"
               managed="false"
               visible="false"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0">

        <VBox styleClass="security-popup-container"
              alignment="CENTER"
              spacing="20">

            <Label text="SECURITY ALERT"
                   styleClass="security-popup-title"/>

            <Label fx:id="securityAlertMessage"
                   styleClass="security-popup-message"
                   wrapText="true"
                   maxWidth="350"
                   text="You have exceeded the maximum number of password attempts.&#10;&#10;For security reasons, you have been logged out."/>

            <Button text="OK"
                    styleClass="security-popup-button"
                    onAction="#handleSecurityAlertOk"/>

        </VBox>
    </StackPane>

</AnchorPane>