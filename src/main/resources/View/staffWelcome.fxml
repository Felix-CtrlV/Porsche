<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<AnchorPane fx:id="rootPane" maxHeight="580.0" maxWidth="1188.0" minHeight="580.0" minWidth="1188.0" prefHeight="580.0" prefWidth="1188.0" style="-fx-background-color: black;" stylesheets="@../CSS/DashBoard_general.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffWelcomeController">

    <StackPane fx:id="contentPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <VBox fx:id="mainContent" style="-fx-background-color: black;">
                <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: black;">
                        <children>
                            <ImageView fitHeight="40" fitWidth="36" preserveRatio="true">
                                <image>
                                    <Image url="@../Image/porsche_logo.png" />
                                </image>
                            </ImageView>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="settingsButton" onMouseClicked="#toggleProfileMenu" onMouseEntered="#onSettingsButtonEntered" onMouseExited="#onSettingsButtonExited" style="-fx-background-color: transparent; -fx-cursor: hand;                                     -fx-text-fill: white; -fx-font-size: 20; -fx-padding: 8 8 8 8;" text="⚙" />
                        </children>
                        <padding>
                            <Insets bottom="10" left="15" right="15" top="10" />
                        </padding>
                    </HBox>

                    <HBox prefHeight="520.0" style="-fx-background-color: black;">
                        <children>
                            <VBox fx:id="vbox" prefWidth="350" spacing="15" style="-fx-background-color: black;">
                                <children>
                                    <Region prefHeight="20" />
                                    <Label fx:id="topicLabel" styleClass="topic_font" text="PORSCHE" textFill="WHITE">
                                        <padding>
                                            <Insets left="20.0" />
                                        </padding>
                                    </Label>
                                    <Label fx:id="headingLabel" styleClass="heading" text="No Substitute" textFill="WHITE">
                                        <padding>
                                            <Insets left="20.0" />
                                        </padding>
                                    </Label>
                                    <Button fx:id="discoverbtn" onAction="#discover" prefWidth="160" styleClass="square-button" text="View Models">
                                        <VBox.margin>
                                            <Insets left="20.0" />
                                        </VBox.margin>
                                    </Button>

                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label text="Looking for:" textFill="WHITE" />
                                            <Button fx:id="accessorybtn" onAction="#clickaccessorybtn" styleClass="transparent-button" text="Accessories" />
                                        </children>
                                        <padding>
                                            <Insets left="20" />
                                        </padding>
                                    </HBox>

                                    <Region VBox.vgrow="ALWAYS" />

                                    <Line endX="100" stroke="WHITE" style="-fx-opacity:0.5;">
                                        <VBox.margin>
                                            <Insets left="20" />
                                        </VBox.margin>
                                    </Line>

                                    <Label text="Porsche is built with unmatched precision and passion.&#10;Every detail reflects timeless craftsmanship and innovation.&#10;The result: pure perfection in motion" textFill="WHITE" wrapText="true">
                                        <padding>
                                            <Insets left="20" right="15" />
                                        </padding>
                                    </Label>
                                </children>
                            </VBox>

                            <StackPane fx:id="imageContainer" styleClass="bg-img-pane" HBox.hgrow="ALWAYS">
                                <children>
                                    <ImageView fx:id="backgroundImage" fitHeight="470.0" fitWidth="838.0" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@../Image/startUpImage.png" />
                                        </image>
                                    </ImageView>
                                </children>
                            </StackPane>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </StackPane>

    <VBox fx:id="settingsPopup" alignment="CENTER_LEFT" layoutX="1000.0" layoutY="65.0" managed="false" prefWidth="200" style="-fx-background-color: #222; -fx-background-radius: 10;                  -fx-border-color: #555; -fx-border-radius: 10;                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 2);" visible="false" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="65.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15 15 10 15;">
                <children>
                    <StackPane>
                        <ImageView fx:id="profilePictureView" fitHeight="40" fitWidth="40" preserveRatio="true">
                            <image>
                                <Image url="@../Image/usericon.png" />
                            </image>
                            <clip>
                                <Circle centerX="20" centerY="20" radius="20" />
                            </clip>
                        </ImageView>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" />
                        <Label fx:id="userRoleLabel" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11;" />
                    </VBox>
                </children>
            </HBox>

            <Line endX="180" stroke="#555" strokeWidth="1" />

            <Button onAction="#handleChangePassword" style="-fx-text-fill: white; -fx-background-color: transparent;                            -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;                            -fx-cursor: hand; -fx-background-radius: 5;" text="Change Password" />
            <Button onAction="#handleChangeProfilePicture" style="-fx-text-fill: white; -fx-background-color: transparent;                            -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;                            -fx-cursor: hand; -fx-background-radius: 5;" text="Change Profile Picture" />
            <Button onAction="#handlePaymentDetails" style="-fx-text-fill: white; -fx-background-color: transparent;                            -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;                            -fx-cursor: hand; -fx-background-radius: 5;" text="Payment Details" />
            <Line endX="180" stroke="#555" strokeWidth="1" />
            <Button onAction="#logout" style="-fx-text-fill: #ff4444; -fx-background-color: transparent;                            -fx-alignment: CENTER_LEFT; -fx-padding: 8 15 8 15;                            -fx-cursor: hand; -fx-background-radius: 5;" text="Logout" />
        </children>
    </VBox>

    <VBox fx:id="paymentPopup" alignment="CENTER" managed="false" prefHeight="500" prefWidth="800" styleClass="payment-popup" visible="false" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="194.0" AnchorPane.rightAnchor="194.0" AnchorPane.topAnchor="40.0">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Payment Management" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRefreshPayments" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Refresh" />
            <Button onAction="#handleClosePayments" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15 8 15;" text="Close" />
        </HBox>

        <HBox alignment="CENTER" spacing="15">
            <VBox prefWidth="120" spacing="5" styleClass="payment-stat-card">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold;" styleClass="payment-stat-pending" text="Pending" />
                <Label fx:id="paymentPendingCount" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="0" />
            </VBox>

            <VBox prefWidth="120" spacing="5" styleClass="payment-stat-card">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold;" styleClass="payment-stat-overdue" text="Overdue" />
                <Label fx:id="paymentOverdueCount" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="0" />
            </VBox>

            <VBox prefWidth="120" spacing="5" styleClass="payment-stat-card">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold;" styleClass="payment-stat-paid" text="Paid" />
                <Label fx:id="paymentPaidCount" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="0" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Search:" />
            <TextField fx:id="paymentSearchField" promptText="Search by Order ID or Installment..." style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-border-color: #555; -fx-pref-width: 250;" />

            <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Status:" />
            <ComboBox fx:id="paymentStatusFilter" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-pref-width: 120;" />
        </HBox>

        <TableView fx:id="paymentTable" styleClass="payment-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colInstallmentId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colOrderId" prefWidth="80" text="Order ID" />
                <TableColumn fx:id="colInstallmentNumber" prefWidth="100" text="Installment #" />
                <TableColumn fx:id="colDueDate" prefWidth="100" text="Due Date" />
                <TableColumn fx:id="colAmount" prefWidth="100" text="Amount" />
                <TableColumn fx:id="colStatus" prefWidth="80" text="Status" />
                <TableColumn fx:id="colAction" prefWidth="100" text="Action" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label style="-fx-text-fill: #ccc; -fx-font-size: 12; -fx-wrap-text: true;" text="Click 'Pay' button to process installment payments. Green status indicates paid, orange indicates pending, red indicates overdue." />
    </VBox>

    <VBox fx:id="passwordVerifyPane" alignment="CENTER" managed="false" prefHeight="250" prefWidth="350" spacing="20" style="-fx-background-color: #1a1a1a; -fx-background-radius: 15;                  -fx-border-color: #333; -fx-border-radius: 15;                  -fx-border-width: 2; -fx-padding: 30;" visible="false" AnchorPane.bottomAnchor="165.0" AnchorPane.leftAnchor="419.0" AnchorPane.rightAnchor="419.0" AnchorPane.topAnchor="165.0">

        <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Security Verification" />

        <Label style="-fx-text-fill: #ccc; -fx-font-size: 12;" text="Please enter your password to continue" />

        <VBox alignment="CENTER" spacing="10">
            <PasswordField fx:id="verifyPasswordField" promptText="Enter your password" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;                                  -fx-border-color: #555; -fx-pref-width: 250;                                  -fx-background-radius: 8; -fx-border-radius: 8;" />

            <Label fx:id="passwordErrorLabel" style="-fx-text-fill: #ff4444; -fx-font-size: 11;" visible="false" />
        </VBox>

        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="cancelVerifyBtn" style="-fx-background-color: #666; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-padding: 8 20 8 20;                            -fx-background-radius: 8;" text="Cancel" />

            <Button fx:id="verifyPasswordBtn" style="-fx-background-color: #ff4444; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-padding: 8 20 8 20;                            -fx-background-radius: 8;" text="Verify" />
        </HBox>
    </VBox>

    <StackPane fx:id="securityLockOverlay" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.8);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox alignment="CENTER" prefHeight="300" prefWidth="400" spacing="20" style="-fx-background-color: #1a1a1a; -fx-background-radius: 15;                      -fx-border-color: #ff4444; -fx-border-radius: 15;                      -fx-border-width: 2; -fx-padding: 40;">

            <Label fx:id="lockIcon" style="-fx-font-size: 48;" text="🔒" />

            <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Account Temporarily Locked" />

            <Label fx:id="lockMessage" maxWidth="350" style="-fx-text-fill: #ccc; -fx-font-size: 14; -fx-alignment: center;" wrapText="true" />

            <Label style="-fx-text-fill: #ff4444; -fx-font-size: 12; -fx-font-weight: bold;" text="Please check your email for unlock instructions" />
        </VBox>
    </StackPane>

    <StackPane fx:id="securityAlertOverlay" managed="false" styleClass="security-popup-overlay" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox alignment="CENTER" spacing="20" styleClass="security-popup-container">

            <Label styleClass="security-popup-title" text="SECURITY ALERT" />

            <Label fx:id="securityAlertMessage" maxWidth="350" styleClass="security-popup-message" text="You have exceeded the maximum number of password attempts.&#10;&#10;For security reasons, you have been logged out." wrapText="true" />

            <Button onAction="#handleSecurityAlertOk" styleClass="security-popup-button" text="OK" />

        </VBox>
    </StackPane>

    <StackPane fx:id="logoutConfirmOverlay" managed="false" styleClass="logout-confirm-overlay" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox alignment="CENTER" prefHeight="180" prefWidth="300" spacing="15" styleClass="logout-confirm-container">

            <VBox alignment="CENTER" spacing="8">
                <Label styleClass="logout-confirm-title" text="Confirm Logout" />
                <Label styleClass="logout-confirm-message" text="Are you sure you want to logout?" />
            </VBox>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="logoutCancelBtn" onAction="#handleLogoutCancel" styleClass="logout-cancel-button" text="Cancel" />
                <Button fx:id="logoutConfirmBtn" onAction="#handleLogoutConfirm" styleClass="logout-confirm-button" text="Logout" />
            </HBox>
        </VBox>
    </StackPane>

</AnchorPane>
