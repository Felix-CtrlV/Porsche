<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffinternalcartController">
    <children>
        <HBox prefHeight="250.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
            <children>
                <ImageView fx:id="img" fitHeight="232.0" fitWidth="601.0" pickOnBounds="true" preserveRatio="true" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="116.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
            <children>
                <Label prefHeight="21.0" prefWidth="62.0" text="Name  :" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="40.0" />
                    </HBox.margin>
                </Label>
                <Label fx:id="namelbl" prefHeight="21.0" prefWidth="86.0" text="Carjack" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </Label>
                <Label text="Price  :" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="220.0" />
                    </HBox.margin>
                </Label>
                <Label fx:id="pricelbl" text="20000$" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <children>
                <Button fx:id="deletebtn" mnemonicParsing="false" onAction="#clickdeletebtn" prefHeight="47.0" prefWidth="34.0" text="🗑" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="50.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="minusbtn" mnemonicParsing="false" onAction="#clickminusbtn" text="-" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="220.0" />
                    </HBox.margin>
                </Button>
                <Label fx:id="numberlbl" text="0" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Label>
                <Button fx:id="plusebtn" mnemonicParsing="false" onAction="#clickplusebtn" text="+" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="comfirmbtn" mnemonicParsing="false" onAction="#clickcomfirmbtn" text="comfirm" HBox.hgrow="ALWAYS">
                    <HBox.margin>
                        <Insets left="50.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
