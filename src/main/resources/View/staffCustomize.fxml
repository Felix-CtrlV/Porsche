<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Line?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            styleClass="root-pane"
            stylesheets="@../CSS/customize_page.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.staffCustomizeController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="28" left="40" right="40"/>
            </padding>
            <Label fx:id="modelName" styleClass="top-title"/>
            <HBox prefHeight="3" prefWidth="140" styleClass="top-divider"/>
            <Label fx:id="modelPrice" styleClass="top-price"/>
        </VBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <ImageView fx:id="modelImage"
                       fitWidth="920"
                       fitHeight="420"
                       preserveRatio="true"
                       styleClass="main-car"/>
        </StackPane>
    </center>

    <left>
        <VBox spacing="20">
            <padding>
                <Insets top="40" left="40"/>
            </padding>
            <Label fx:id="fuelType" styleClass="fuel-badge"/>
            <Label fx:id="carDescription" wrapText="true" maxWidth="260" styleClass="description-text"/>
            <VBox spacing="0" styleClass="details-container">
                <Label text="Car Details" styleClass="details-title"/>
                <Line styleClass="details-divider"/>
                <HBox alignment="CENTER_LEFT" styleClass="details-row">
                    <Label text="Speed:" styleClass="details-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="carSpeedLabel" styleClass="details-value"/>
                </HBox>
                <Line styleClass="details-divider"/>
                <HBox alignment="CENTER_LEFT" styleClass="details-row">
                    <Label text="Production Year:" styleClass="details-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="productionYearLabel" styleClass="details-value"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <bottom>
        <VBox spacing="20" styleClass="customization-bar">
            <padding>
                <Insets top="24" bottom="26" left="40" right="40"/>
            </padding>
            <HBox spacing="24" alignment="CENTER">
                <VBox minWidth="360" spacing="12" styleClass="option-card">
                    <HBox alignment="CENTER_LEFT" styleClass="option-header">
                        <Label text="Exterior Color" styleClass="option-title"/>
                    </HBox>
                    <FlowPane fx:id="colorContainer" alignment="CENTER" hgap="12" styleClass="option-flowpane"/>
                </VBox>
                <VBox minWidth="360" spacing="12" styleClass="option-card">
                    <HBox alignment="CENTER_LEFT" styleClass="option-header">
                        <Label text="Interior Color" styleClass="option-title"/>
                    </HBox>
                    <FlowPane fx:id="interiorContainer" alignment="CENTER" hgap="12" styleClass="option-flowpane"/>
                </VBox>
                <VBox minWidth="200" spacing="12" styleClass="option-card" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="10" styleClass="option-flowpane">
                        <Button fx:id="backBtn" text="← Back" styleClass="step-btn" onAction="#handleBack" maxWidth="Infinity" prefHeight="40"/>
                        <Button fx:id="confirmBtn" text="Confirm Order" onAction="#handleConfirmOrder" styleClass="confirm-btn" maxWidth="Infinity" prefHeight="40"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>