<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="550.0" prefWidth="500.0" style="-fx-background-color: rgba(0,0,0,0.5);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ChangePasswordController">
    <VBox alignment="CENTER" maxWidth="450.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 5);">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: linear-gradient(to right, #1a1a1a, #2d2d2d); -fx-background-radius: 16 16 0 0; -fx-padding: 20 25;">
            <StackPane minHeight="48.0" minWidth="48.0" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 24;">
                <Label style="-fx-font-size: 24; -fx-text-fill: white;" text="🔐" />
            </StackPane>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" text="Change Password" />
                <Label style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.8);" text="Secure your account with a new password" />
            </VBox>
            <Label fx:id="closeBtn" onMouseClicked="#closeWindow" style="-fx-font-size: 24; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Label>
        </HBox>

        
        <!-- Content Area -->
        <StackPane style="-fx-padding: 30;">
            <!-- Step 1: Current Password -->
            <VBox fx:id="passwordVerificationPane" alignment="CENTER" spacing="20.0" visible="true">
                <VBox alignment="CENTER" spacing="8.0">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Step 1: Verify Current Password" />
                    <Label style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Enter your current password to proceed" textAlignment="CENTER" wrapText="true" />
                </VBox>
                
                <VBox spacing="10.0" style="-fx-max-width: 350;">
                    <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Current Password" />
                    <PasswordField fx:id="currentPasswordField" promptText="Enter your current password" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                </VBox>
                
                <Button fx:id="verifyPasswordBtn" onAction="#onVerifyPassword" prefHeight="48.0" prefWidth="350.0" style="-fx-background-color: linear-gradient(to right, #1a1a1a, #2d2d2d); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Verify &amp; Send OTP">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                
                <Label fx:id="passwordVerifyStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
            </VBox>
            
            <!-- Step 2: OTP Verification -->
            <VBox fx:id="otpVerificationPane" alignment="CENTER" spacing="20.0" visible="false">
                <VBox alignment="CENTER" spacing="8.0">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Step 2: Verify OTP" />
                    <Label fx:id="otpEmailLabel" style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Enter the 6-digit code sent to your email" textAlignment="CENTER" wrapText="true" />
                </VBox>
                
                <VBox spacing="10.0" style="-fx-max-width: 350;">
                    <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="OTP Code" />
                    <TextField fx:id="otpField" promptText="Enter 6-digit OTP" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                </VBox>
                
                <Button fx:id="verifyOtpBtn" onAction="#onVerifyOTP" prefHeight="48.0" prefWidth="350.0" style="-fx-background-color: linear-gradient(to right, #1a1a1a, #2d2d2d); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Verify OTP">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                
                <Button fx:id="resendOtpBtn" onAction="#onResendOTP" prefHeight="36.0" prefWidth="350.0" style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-font-size: 13; -fx-font-weight: 600; -fx-cursor: hand; -fx-underline: true;" text="Resend OTP">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                
                <Label fx:id="otpVerifyStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
            </VBox>
            
            <!-- Step 3: New Password -->
            <VBox fx:id="newPasswordPane" alignment="CENTER" spacing="20.0" visible="false">
                <VBox alignment="CENTER" spacing="8.0">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Step 3: Set New Password" />
                    <Label style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Create a strong password for your account" textAlignment="CENTER" wrapText="true" />
                </VBox>
                
                <VBox spacing="15.0" style="-fx-max-width: 350;">
                    <VBox spacing="10.0">
                        <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="New Password" />
                        <PasswordField fx:id="newPasswordField" promptText="Enter new password" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                    </VBox>
                    
                    <VBox spacing="10.0">
                        <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Confirm Password" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                    </VBox>
                </VBox>
                
                <Button fx:id="changePasswordBtn" onAction="#onSubmitPasswordChange" prefHeight="48.0" prefWidth="350.0" style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="✓ Change Password">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                
                <Label fx:id="changePasswordStatus" style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" textAlignment="CENTER" wrapText="true" />
            </VBox>
            
            <!-- Loading Indicator -->
            <StackPane fx:id="loadingPane" style="-fx-background-color: rgba(255,255,255,0.9);" visible="false">
                <VBox alignment="CENTER" spacing="15.0">
                    <ProgressIndicator prefHeight="50.0" prefWidth="50.0" />
                    <Label style="-fx-font-size: 14; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Processing..." />
                </VBox>
            </StackPane>
        </StackPane>
        
        <!-- Message Bar -->
        <HBox fx:id="messagePane" alignment="CENTER" prefHeight="50.0" style="-fx-background-color: #10b981; -fx-background-radius: 0 0 16 16;" visible="false">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <Label fx:id="messageLabel" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: white;" text="Success!" />
        </HBox>
    </VBox>
</StackPane>
