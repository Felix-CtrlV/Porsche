<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.managerAttendanceManagementController">
    <!-- Attendance Management Pane -->
    <VBox fx:id="attendanceManagementPane" spacing="15.0" style="-fx-background-color: transparent;" visible="true">
        <padding>
            <Insets bottom="10.0" left="0.0" right="0.0" top="0.0" />
        </padding>

        <!-- Header Card -->
        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <StackPane minHeight="40.0" minWidth="40.0" style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2); -fx-background-radius: 10;">
                    <Label style="-fx-font-size: 20; -fx-text-fill: white;" text="📅" />
                </StackPane>
                <VBox spacing="2.0">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Staff Attendance Management" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #64748b;" text="Track and manage staff attendance records" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Filter Controls Card -->
        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <children>
                <!-- Filter Section -->
                <VBox spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 10;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label style="-fx-font-size: 14; -fx-text-fill: #667eea;" text="🔍" />
                        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Filter Options" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox spacing="5.0">
                            <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Staff Member" />
                            <ComboBox fx:id="staffCombo" minHeight="49.0" prefWidth="180.0" promptText="Select staff..." style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Date Range" />
                            <Button fx:id="dateRangeBtn" minHeight="49.0" onAction="#showDateRangePicker" prefHeight="45.0" prefWidth="200.0" style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-text-fill: #6b7280; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);" text="Select date range..." />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Status" />
                            <ComboBox fx:id="statusCombo" minHeight="49.0" prefWidth="140.0" promptText="All" style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 8 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);" />
                        </VBox>
                        <Button fx:id="addAbsentBtn" onAction="#onAddAbsent" prefHeight="28.0" prefWidth="80.0" style="-fx-background-color: linear-gradient(to right, #ef4444, #dc2626); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);" text="➕Absent">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <HBox.margin>
                        <Insets top="19.0" />
                     </HBox.margin>
                        </Button>
                    </HBox>
                </VBox>
            </children>
        </VBox>

        <!-- Summary Stats Card -->
        <HBox spacing="15.0">
            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <StackPane minHeight="30.0" minWidth="30.0" style="-fx-background-color: #10b981; -fx-background-radius: 8;">
                        <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="✓" />
                    </StackPane>
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 12; -fx-text-fill: #64748b;" text="Present Today" />
                        <Label fx:id="presentTodayLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <StackPane minHeight="30.0" minWidth="30.0" style="-fx-background-color: #ef4444; -fx-background-radius: 8;">
                        <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="✗" />
                    </StackPane>
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 12; -fx-text-fill: #64748b;" text="Absent Today" />
                        <Label fx:id="absentTodayLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <StackPane minHeight="30.0" minWidth="30.0" style="-fx-background-color: #f59e0b; -fx-background-radius: 8;">
                        <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="⏰" />
                    </StackPane>
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 12; -fx-text-fill: #64748b;" text="Late Today" />
                        <Label fx:id="lateTodayLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <StackPane minHeight="30.0" minWidth="30.0" style="-fx-background-color: #667eea; -fx-background-radius: 8;">
                        <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="👥" />
                    </StackPane>
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 12; -fx-text-fill: #64748b;" text="Total Staff" />
                        <Label fx:id="totalStaffLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Attendance Table Card -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label style="-fx-font-size: 14; -fx-text-fill: #667eea;" text="📋" />
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Attendance Records" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="recordCountLabel" style="-fx-font-size: 12; -fx-text-fill: #64748b;" text="0 records" />
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <TableView fx:id="attendanceTable" style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 12; -fx-border-width: 1.5; -fx-table-cell-border-color: #e9ecef;">
                    <columns>
                        <TableColumn fx:id="staffNameCol" prefWidth="140.0" text="Staff Name" />
                        <TableColumn fx:id="dateCol" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="checkInCol" prefWidth="100.0" text="Check In" />
                        <TableColumn fx:id="checkOutCol" prefWidth="100.0" text="Check Out" />
                        <TableColumn fx:id="hoursWorkedCol" prefWidth="110.0" text="Hours" />
                        <TableColumn fx:id="remarksCol" prefWidth="200.0" text="Remarks" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </ScrollPane>
        </VBox>
    </VBox>

    <!-- Date Range Picker Backdrop -->
    <Pane fx:id="dateRangeBackdrop" onMouseClicked="#closeDateRangePicker" style="-fx-background-color: rgba(0,0,0,0.4);" visible="false" />

                         <!-- Date Range Picker Dialog -->
    <VBox fx:id="dateRangePanel" alignment="TOP_CENTER" maxHeight="450.0" maxWidth="400.0" prefHeight="450.0" prefWidth="400.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 25, 0, 0, 8);" translateY="-180.0" visible="false" StackPane.alignment="CENTER">
        <children>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" minHeight="50.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 12 12 0 0; -fx-padding: 15;">
                <children>
                    <StackPane minHeight="30.0" minWidth="30.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 15;">
                        <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="📅" />
                    </StackPane>
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: white;" text="Select Date Range" HBox.hgrow="ALWAYS" />
                    <Label fx:id="closeDateRangeBtn" onMouseClicked="#closeDateRangePicker" style="-fx-font-size: 14; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Label>
                </children>
            </HBox>

                                 <!-- Calendar Content -->
            <VBox spacing="15.0" style="-fx-padding: 20;">
                <children>
                    <!-- Always Visible Calendar -->
                    <VBox fx:id="dateRangePickerPanel" prefHeight="280.0" prefWidth="360.0" spacing="0.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 0;">
                        <!-- Calendar Header -->
                        <HBox alignment="CENTER" spacing="0.0" style="-fx-padding: 15 20 10 20;">
                            <Button fx:id="prevMonthBtn" onAction="#previousMonth" prefWidth="40.0" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 16; -fx-cursor: hand; -fx-padding: 6;" text="‹">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>
                            <Label fx:id="monthYearLabel" alignment="CENTER" prefWidth="280.0" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="October 2025" />
                            <Button fx:id="nextMonthBtn" onAction="#nextMonth" prefWidth="40.0" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 16; -fx-cursor: hand; -fx-padding: 6;" text="›">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>
                        </HBox>

                                             <!-- Day Headers -->
                        <HBox alignment="CENTER" spacing="0.0" style="-fx-padding: 0 20 8 20;">
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Sun" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Mon" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Tue" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Wed" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Thu" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Fri" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Sat" />
                        </HBox>

                                             <!-- Calendar Grid -->
                        <VBox fx:id="calendarGrid" spacing="0.0" style="-fx-padding: 0 20 15 20;" />
                    </VBox>

                                         <!-- Selected Date Display -->
                    <Label fx:id="selectedDateLabel" style="-fx-font-size: 12; -fx-text-fill: #667eea; -fx-font-weight: 600; -fx-alignment: center;" text="No dates selected" />

                                         <!-- Action Buttons -->
                    <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 5 0 0 0;">
                        <Button fx:id="cancelDateRangeBtn" onAction="#closeDateRangePicker" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancel">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        <Button fx:id="applyDateRangeBtn" onAction="#applyDateRange" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Apply">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>

</StackPane>
