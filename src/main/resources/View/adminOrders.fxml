<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" style="-fx-background-color: #f8fafc;" stylesheets="@../CSS/DashBoard_general.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.adminOrderController">
   <top>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Title and Date Controls -->
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="20.0">
               <children>
                  <Label styleClass="topic_font" text="Orders" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  
                  <!-- Month/Year Navigation (matching adminAccount style) -->
                  <HBox alignment="CENTER_RIGHT" prefHeight="38.0" spacing="10.0" style="-fx-background-color: white; -fx-border-radius: 9; -fx-background-radius: 8; -fx-border-color: #dadce0;">
                     <children>
                        <Button fx:id="PreviousMonthbtn" mnemonicParsing="false" onAction="#clickMonthPrev" style="-fx-background-color: transparent;" styleClass="topic_font" text="◀" />
                        <ChoiceBox fx:id="monthBox" prefHeight="26.0" prefWidth="76.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-color: #dadce0; -fx-border-radius: 9; -fx-background-insets: 0; -fx-padding: 0;" />
                        <Button fx:id="NextMonthbtn" mnemonicParsing="false" onAction="#clickMonthNext" style="-fx-background-color: transparent;" styleClass="topic_font" text="▶" />
                        
                        <Region prefHeight="26.0" prefWidth="7.0" />
                        
                        <Button fx:id="PreviousYearbtn" mnemonicParsing="false" onAction="#clickYearPrev" style="-fx-background-color: transparent;" styleClass="topic_font" text="◀" />
                        <ChoiceBox fx:id="yearBox" prefHeight="26.0" prefWidth="76.0" style="-fx-background-color: transparent; -fx-border-color: #dadce0; -fx-background-radius: 8; -fx-border-radius: 8; -fx-background-insets: 0; -fx-padding: 0;" />
                        <Button fx:id="NextYearbtn" mnemonicParsing="false" onAction="#clickYearNext" style="-fx-background-color: transparent;" styleClass="topic_font" text="▶" />
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                     </padding>
                  </HBox>
               </children>
               <padding>
                  <Insets left="30.0" right="30.0" />
               </padding>
            </HBox>
            
            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="searchField" promptText="Search by customer name, order ID, or status..." style="-fx-background-color: white; -fx-border-color: #dadce0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </TextField>
                  <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#clickSearch" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20;" text="Search">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets left="30.0" right="30.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <HBox spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Main Table -->
            <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                  <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="orders_col" prefWidth="75.0" text="Order ID" />
                      <TableColumn fx:id="customer_col" prefWidth="150.0" text="Customer" />
                        <TableColumn fx:id="date_col" prefWidth="100.0" text="Date" />
                        <TableColumn fx:id="status_col" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="total_col" prefWidth="100.0" text="Total" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            
            <!-- Stats Pane -->
            <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #1e293b;" text="Order Statistics">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  
                  <!-- Total Orders Card -->
                  <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="Total Orders" />
                        <Label fx:id="totalOrdersLbl" style="-fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #2c3e50;" text="0">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                        <Label fx:id="totalOrdersMonthLbl" style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="in selected month" />
                     </children>
                  </VBox>
                  
                  <!-- Searched Orders Card -->
                  <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #ecfdf5; -fx-background-radius: 10; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-text-fill: #059669; -fx-font-size: 13;" text="Filtered Results" />
                        <Label fx:id="searchedOrdersLbl" style="-fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #059669;" text="0">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                        <Label style="-fx-text-fill: #059669; -fx-font-size: 11;" text="matching search" />
                     </children>
                  </VBox>
                  
                  <!-- Total Revenue Card -->
                  <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #fef3c7; -fx-background-radius: 10; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-text-fill: #d97706; -fx-font-size: 13;" text="Total Revenue" />
                        <Label fx:id="totalRevenueLbl" style="-fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #d97706;" text="0.00">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <Label style="-fx-text-fill: #d97706; -fx-font-size: 11;" text="from filtered orders" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
         </padding>
      </HBox>
   </center>
</BorderPane>
