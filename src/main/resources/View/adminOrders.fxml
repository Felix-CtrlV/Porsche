<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../CSS/DashBoard_general.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.adminOrderController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="76.0" prefWidth="600.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label maxWidth="1.7976931348623157E308" styleClass="topic_font" text="Orders" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </Label>
            <StackPane prefHeight="38.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="searchField" prefHeight="38.0" prefWidth="200.0" promptText="Search by car model..." style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 5 15 5 15;" />
                  <Button fx:id="searchBtn" mnemonicParsing="false" prefHeight="25.0" prefWidth="48.0" style="-fx-background-color: transparent;" text="🔍" StackPane.alignment="CENTER_RIGHT">
                     <StackPane.margin>
                        <Insets right="5.0" />
                     </StackPane.margin>
                  </Button>
               </children>
            </StackPane>
            <HBox alignment="CENTER_RIGHT" prefHeight="38.0" spacing="10.0" style="-fx-background-color: white; -fx-border-radius: 9; -fx-background-radius: 8; -fx-border-color: #dadce0;">
               <children>
                  <Button fx:id="monthPrev" mnemonicParsing="false" onAction="#clickMonthPrev" style="-fx-background-color: transparent;" styleClass="topic_font" text="◀" />
                  <ChoiceBox fx:id="monthBox" prefHeight="26.0" prefWidth="76.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-color: #dadce0; -fx-border-radius: 9; -fx-background-insets: 0; -fx-padding: 0;" />
                  <Button fx:id="monthNext" mnemonicParsing="false" onAction="#clickMonthNext" style="-fx-background-color: transparent;" styleClass="topic_font" text="▶" />
                  
                  <Region prefHeight="26.0" prefWidth="7.0" />
                  
                  <Button fx:id="yearPrev" mnemonicParsing="false" onAction="#clickYearPrev" style="-fx-background-color: transparent;" styleClass="topic_font" text="◀" />
                  <ChoiceBox fx:id="yearBox" prefHeight="26.0" prefWidth="76.0" style="-fx-background-color: transparent; -fx-border-color: #dadce0; -fx-background-radius: 8; -fx-border-radius: 8; -fx-background-insets: 0; -fx-padding: 0;" />
                  <Button fx:id="yearNext" mnemonicParsing="false" onAction="#clickYearNext" style="-fx-background-color: transparent;" styleClass="topic_font" text="▶" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets right="30.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                  <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="orders_col" prefWidth="75.0" text="Orders" />
                      <TableColumn fx:id="customer_col" prefWidth="75.0" text="Customer" />
                        <TableColumn fx:id="date_col" prefWidth="75.0" text="Date" />
                        <TableColumn fx:id="status_col" prefWidth="75.0" text="Status" />
                        <TableColumn fx:id="total_col" prefWidth="75.0" text="Total" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </TableView>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </VBox>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="180.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #dadce0; -fx-border-radius: 8; -fx-background-radius: 8;">
               <padding>
                  <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
               </padding>
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #1e293b;" text="Order Statistics" />
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="Total Orders" />
                        <Text fx:id="totalOrdersText" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-fill: #1e293b;" text="0" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f0f9ff; -fx-border-color: #bae6fd; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 15;">
                     <children>
                        <Label style="-fx-text-fill: #0369a1; -fx-font-size: 12;" text="Searched Orders" />
                        <Text fx:id="searchedOrdersText" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-fill: #0369a1;" text="0" />
                     </children>
                  </VBox>
               </children>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
