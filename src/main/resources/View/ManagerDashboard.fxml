                        <Button fx:id="briminventory" mnemonicParsing="false" onAction="#clickinventory" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Inventory ">
