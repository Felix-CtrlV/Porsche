<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="420.0" prefWidth="403.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-border-color: transparent; -fx-background-radius: 16; -fx-border-radius: 16;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ForgotPasswordController">
    <VBox alignment="CENTER" maxWidth="400.0" prefHeight="396.0" prefWidth="400.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 5);">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: linear-gradient(to right, #1a1a1a, #2d2d2d); -fx-background-radius: 16 16 0 0; -fx-padding: 10 20 10 20;">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" text="Forgot Password" />
                <Label style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.8);" text="Recover access to your account" />
            </VBox>
            <Label fx:id="closeBtn" onMouseClicked="#onCloseClicked" style="-fx-font-size: 24; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Label>
        </HBox>

        <!-- Content Area -->
        <StackPane style="-fx-padding: 24;">
            <!-- Step 1: Email Input -->
            <VBox fx:id="emailPane" alignment="CENTER" spacing="16.0" visible="true">
                <VBox alignment="CENTER" spacing="6.0">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Step 1: Account Verification" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Enter your email or username to receive a verification code" textAlignment="CENTER" wrapText="true" />
                </VBox>

                <VBox spacing="8.0" style="-fx-max-width: 300;">
                    <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Email or Username" />
                    <TextField fx:id="emailTxt" promptText="Enter your email or username" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                </VBox>

                <Button fx:id="sendOtpBtn" onAction="#clickSendOtp" prefHeight="44.0" prefWidth="300.0" style="-fx-background-color: linear-gradient(to right, #1a1a1a, #2d2d2d); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Send Verification Code">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button fx:id="backToLoginBtn" onAction="#clickBackToLogin" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 11; -fx-font-weight: 600; -fx-cursor: hand;" text="← Back to Login" />
            <StackPane.margin>
               <Insets />
            </StackPane.margin>
            </VBox>

            <!-- Step 2: OTP Verification -->
            <VBox fx:id="otpPane" alignment="CENTER" spacing="16.0" visible="false">
                <VBox alignment="CENTER" spacing="6.0">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Step 2: Verify OTP" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="We've sent a 6-digit verification code to" textAlignment="CENTER" wrapText="true" />
                    <Label fx:id="emailDisplayLabel" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="email@example.com" />
                </VBox>

                <VBox spacing="8.0" style="-fx-max-width: 300;">
                    <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Verification Code" />
                    <TextField fx:id="otpTxt" promptText="000000" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 18; -fx-font-weight: bold; -fx-alignment: center; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                </VBox>

                <Button fx:id="verifyOtpBtn" onAction="#clickVerifyOtp" prefHeight="44.0" prefWidth="300.0" style="-fx-background-color: linear-gradient(to right, #1a1a1a, #2d2d2d); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Verify OTP">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button fx:id="resendOtpBtn" onAction="#clickResendOtp" prefHeight="32.0" prefWidth="300.0" style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-font-size: 12; -fx-font-weight: 600; -fx-cursor: hand; -fx-underline: true;" text="Resend OTP">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>

            <!-- Step 3: New Password -->
            <VBox fx:id="passwordPane" alignment="CENTER" spacing="16.0" visible="false">
                <VBox alignment="CENTER" spacing="6.0">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Step 3: Set New Password" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Create a strong password for your account" textAlignment="CENTER" wrapText="true" />
                </VBox>

                <VBox spacing="12.0" style="-fx-max-width: 300;">
                    <VBox spacing="8.0">
                        <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="New Password" />
                        <PasswordField fx:id="newPasswordTxt" promptText="Enter new password" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Confirm Password" />
                        <PasswordField fx:id="confirmPasswordTxt" promptText="Confirm new password" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 13; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1.5;" />
                    </VBox>
                </VBox>

                <Button fx:id="resetPasswordBtn" onAction="#clickResetPassword" prefHeight="44.0" prefWidth="300.0" style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="✓ Reset Password">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>

            <!-- Loading Indicator -->
            <StackPane fx:id="loadingPane" style="-fx-background-color: rgba(255,255,255,0.9);" visible="false">
                <VBox alignment="CENTER" spacing="15.0">
                    <ProgressIndicator prefHeight="44.0" prefWidth="44.0" />
                    <Label style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Processing..." />
                </VBox>
            </StackPane>
         <VBox.margin>
            <Insets top="11.0" />
         </VBox.margin>
        </StackPane>

        <!-- Message Bar -->
        <StackPane fx:id="messagePane" alignment="CENTER" prefHeight="46.0" style="-fx-background-radius: 12 12 0 0;" translateY="42.0" visible="false">
            <padding>
                <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
            </padding>
            <Label fx:id="messageLabel" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: white;" text="Success!" />
        </StackPane>
    </VBox>
</StackPane>
