<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="600.0" maxWidth="450.0" prefHeight="600.0" prefWidth="450.0" style="-fx-background-color: white; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AddAbsentDialogController">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" minHeight="60.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #ef4444, #dc2626); -fx-background-radius: 12 12 0 0; -fx-padding: 20;">
            <children>
                <StackPane minHeight="35.0" minWidth="35.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 18;">
                    <Label style="-fx-font-size: 16; -fx-text-fill: white;" text="➕" />
                </StackPane>
                <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" text="Add Absent Record" HBox.hgrow="ALWAYS" />
                <Label fx:id="closeDialogBtn" onMouseClicked="#closeDialog" style="-fx-font-size: 16; -fx-text-fill: white; -fx-cursor: hand;" text="✕">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Label>
            </children>
        </HBox>

        <!-- Form Content -->
        <VBox spacing="20.0" style="-fx-padding: 25;">
            <children>
                <VBox spacing="8.0">
                    <Label style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Select Staff" />
                    <ComboBox fx:id="staffComboDialog" prefWidth="350.0" promptText="Choose staff member" style="-fx-font-size: 13; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                </VBox>

                <VBox spacing="8.0">
                    <Label style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Date Range" />

                    <!-- Always Visible Calendar -->
                    <VBox fx:id="dateRangePickerPanel" prefHeight="280.0" prefWidth="400.0" spacing="0.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 0;">
                        <!-- Calendar Header -->
                        <HBox alignment="CENTER" spacing="0.0" style="-fx-padding: 15 20 10 20;">
                            <Button fx:id="prevMonthBtn" onAction="#previousMonth" prefWidth="40.0" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 16; -fx-cursor: hand; -fx-padding: 6;" text="‹">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>
                            <Label fx:id="monthYearLabel" alignment="CENTER" prefWidth="280.0" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="October 2025" />
                            <Button fx:id="nextMonthBtn" onAction="#nextMonth" prefWidth="40.0" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 16; -fx-cursor: hand; -fx-padding: 6;" text="›">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>
                        </HBox>

                        <!-- Day Headers -->
                        <HBox alignment="CENTER" spacing="0.0" style="-fx-padding: 0 20 8 20;">
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Sun" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Mon" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Tue" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Wed" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Thu" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Fri" />
                            <Label prefWidth="35.0" style="-fx-font-size: 11; -fx-font-weight: 600; -fx-text-fill: #9ca3af; -fx-alignment: center;" text="Sat" />
                        </HBox>

                        <!-- Calendar Grid -->
                        <VBox fx:id="calendarGrid" spacing="0.0" style="-fx-padding: 0 20 15 20;" />
                    </VBox>

                    <!-- Selected Date Display -->
                    <Label fx:id="selectedDateLabel" style="-fx-font-size: 12; -fx-text-fill: #667eea; -fx-font-weight: 600;" text="No dates selected" />
                </VBox>

                <VBox spacing="8.0">
                    <Label style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #374151;" text="Reason for Absence" />
                    <TextField fx:id="reasonField" prefWidth="350.0" promptText="e.g., Sick, Personal leave, Emergency" style="-fx-font-size: 13; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12;" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="cancelBtn" onAction="#closeDialog" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancel">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                    <Button fx:id="saveBtn" onAction="#saveAbsentRecord" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: linear-gradient(to right, #ef4444, #dc2626); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Add Record">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
