<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<StackPane styleClass="root-container" stylesheets="@../CSS/finalCheckout.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffShopingCartController">

    <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="scroll-pane">
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <Button fx:id="loadAssetButton" styleClass="link-button" text="View Accessories" />

            <VBox alignment="CENTER" spacing="10">
                <Label styleClass="section-title" text="Final Configuration" />
                <Label styleClass="summary-label" text="Review your customization and choose payment method" />
            </VBox>

            <VBox maxWidth="1000" spacing="20" styleClass="glass-card">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>

                <VBox fx:id="configDetailsContainer" spacing="15">
                    <Label styleClass="section-title" text="Configuration Details" />
                    <VBox spacing="12" styleClass="details-container">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="120" styleClass="detail-label" text="Model:" />
                            <Label fx:id="modelLabel" styleClass="detail-value" text="Model Name" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="120" styleClass="detail-label" text="Color:" />
                            <Label fx:id="colorLabel" styleClass="detail-value" text="Color" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="120" styleClass="detail-label" text="Engine Type:" />
                            <Label fx:id="engineLabel" styleClass="detail-value" text="Engine" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="120" styleClass="detail-label" text="Base Price:" />
                            <Label fx:id="basePriceLabel" styleClass="detail-value price-highlight" text="Price" />
                        </HBox>
                    </VBox>
                </VBox>

                <Line endX="920" strokeWidth="2" styleClass="divider" />

                <VBox spacing="15">
                    <Label styleClass="section-title" text="Selected Accessories" />
                    <VBox fx:id="accessoriesContainer" spacing="8" styleClass="accessories-container" />
                </VBox>

                <Line endX="920" strokeWidth="2" styleClass="divider" />

                <VBox spacing="15">
                    <Label styleClass="section-title" text="Payment Method" />
                    <VBox spacing="12">
                        <fx:define>
                            <ToggleGroup fx:id="paymentMethodGroup" />
                        </fx:define>

                        <RadioButton fx:id="fullPaymentRadio" selected="true" styleClass="payment-radio" text="Full Payment" toggleGroup="$paymentMethodGroup" />
                        <RadioButton fx:id="installmentRadio" styleClass="payment-radio" text="Installment Plan" toggleGroup="$paymentMethodGroup" />
                    </VBox>
                </VBox>

                <VBox fx:id="installmentOptionsContainer" managed="false" spacing="15" visible="false">
                    <Label styleClass="subsection-title" text="Select Installment Plan" />

                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox minWidth="200" spacing="8">
                            <Label styleClass="input-label" text="Payment Plan:" />
                            <ComboBox fx:id="installmentPlanCombo" prefWidth="250" styleClass="custom-combo" />
                        </VBox>

                        <VBox minWidth="200" spacing="8">
                            <Label styleClass="input-label" text="Down Payment:" />
                            <Label fx:id="downPaymentLabel" styleClass="detail-value price-highlight" text="25,000" />
                        </VBox>
                    </HBox>

                    <VBox spacing="12" styleClass="installment-details-card">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label styleClass="subsection-title" text="Payment Breakdown" />

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="150" styleClass="detail-label" text="Monthly Payment:" />
                            <Label fx:id="monthlyPaymentLabel" styleClass="monthly-payment-value" text="5,458" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="150" styleClass="detail-label" text="Number of Months:" />
                            <Label fx:id="monthsLabel" styleClass="detail-value" text="24 months" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="150" styleClass="detail-label" text="Interest Rate (APR):" />
                            <Label fx:id="aprLabel" styleClass="detail-value" text="3.5%" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="150" styleClass="detail-label" text="Total Interest:" />
                            <Label fx:id="totalInterestLabel" styleClass="detail-value" text="6,000" />
                        </HBox>

                        <Line endX="500" strokeWidth="1" styleClass="thin-divider" />

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label minWidth="150" styleClass="total-label" text="Total Amount:" />
                            <Label fx:id="totalWithInterestLabel" styleClass="total-value" text="133,000" />
                        </HBox>
                    </VBox>
                </VBox>

                <Line endX="920" strokeWidth="2" styleClass="divider" />

                <VBox spacing="12" styleClass="summary-container">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label minWidth="200" styleClass="summary-label" text="Base Price:" />
                        <Label fx:id="summaryBasePriceLabel" styleClass="summary-value" text="115,000" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label minWidth="200" styleClass="summary-label" text="Accessories Total:" />
                        <Label fx:id="accessoriesTotalLabel" styleClass="summary-value" text="12,000" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label minWidth="200" styleClass="summary-label" text="Tax (8%):" />
                        <Label fx:id="taxLabel" styleClass="summary-value" text="10,160" />
                    </HBox>
                    <Line endX="920" strokeWidth="3" styleClass="total-divider" />
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label minWidth="200" styleClass="total-label" text="Grand Total:" />
                        <Label fx:id="totalPriceLabel" styleClass="total-value" text="137,160" />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER" spacing="25">
                    <VBox.margin>
                        <Insets top="20" />
                    </VBox.margin>

                    <Button fx:id="backButton" minHeight="45" minWidth="200" prefHeight="45" prefWidth="200" styleClass="back-button" text="BACK" />
                    <Button fx:id="confirmButton" minHeight="45" minWidth="200" prefHeight="45" prefWidth="200" styleClass="confirm-button" text="CONFIRM PURCHASE" />
                </HBox>

                <Label fx:id="confirmationMessageLabel" managed="false" styleClass="confirmation-message" visible="false" />
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>