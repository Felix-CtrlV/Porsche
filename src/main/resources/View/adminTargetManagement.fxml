<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.adminTargetManagementController">
    <!-- Set Target Pane -->
    <VBox fx:id="setTargetPane" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 5);" visible="true">
        <!-- Header Section -->
        <VBox spacing="4.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 16 16 0 0; -fx-padding: 18 20;">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="🎯 Set Sales Target" />
            <Label style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.85);" text="Define monthly sales goals" />
        </VBox>
        
        <!-- Form Content -->
        <VBox spacing="18.0" style="-fx-padding: 20;">
            <children>
        
        <!-- Manager Selection -->
        <VBox spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 10;">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label style="-fx-font-size: 14; -fx-text-fill: #667eea;" text="👤" />
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Select Manager" />
            </HBox>
            <ComboBox fx:id="managerCombo" maxWidth="Infinity" prefHeight="38.0" promptText="Choose a manager..." style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5;" />
        </VBox>
        
        <!-- Period Selection -->
        <VBox spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 10;">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label style="-fx-font-size: 14; -fx-text-fill: #667eea;" text="📅" />
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Target Period" />
            </HBox>
            <HBox spacing="10.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #64748b;" text="Month" />
                    <ComboBox fx:id="monthCombo" maxWidth="Infinity" prefHeight="38.0" promptText="Select month..." style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                </VBox>
                
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #64748b;" text="Year" />
                    <Spinner fx:id="yearSpinner" editable="true" maxWidth="Infinity" prefHeight="38.0" style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Sales Targets -->
        <VBox spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 10;">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label style="-fx-font-size: 14; -fx-text-fill: #667eea;" text="🎯" />
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Sales Targets" />
            </HBox>
            
            <VBox spacing="12.0">
                <!-- Car Target -->
                <VBox spacing="6.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #64748b;" text="🚗 Car Sales" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #94a3b8; -fx-font-style: italic;" text="units/month" />
                    </HBox>
                    <Spinner fx:id="carTargetSpinner" editable="true" maxWidth="Infinity" prefHeight="38.0" style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                </VBox>
                
                <Separator style="-fx-background-color: #e2e8f0;" />
                
                <!-- Parts Target -->
                <VBox spacing="6.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label style="-fx-font-size: 12; -fx-font-weight: 600; -fx-text-fill: #64748b;" text="🔧 Parts Sales" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #94a3b8; -fx-font-style: italic;" text="units/month" />
                    </HBox>
                    <Spinner fx:id="partTargetSpinner" editable="true" maxWidth="Infinity" prefHeight="38.0" style="-fx-font-size: 13; -fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                </VBox>
            </VBox>
        </VBox>
        
        <!-- Action Buttons -->
        <HBox spacing="10.0" style="-fx-padding: 5 0 0 0;">
            <Button onAction="#onSetTarget" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 8, 0, 0, 2);" text="✓ Set Target" HBox.hgrow="ALWAYS" />
            <Button onAction="#onCancel" prefHeight="45.0" style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 10;" text="✕ Cancel" HBox.hgrow="ALWAYS" />
        </HBox>
            </children>
        </VBox>
    </VBox>
    
    <!-- Progress View Pane -->
    <VBox fx:id="progressPane" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 5);" visible="false">
        <!-- Header Section -->
        <VBox spacing="3.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 16 16 0 0; -fx-padding: 15 20;">
            <!-- Back Button Row -->
            <HBox alignment="CENTER_LEFT">
                <Button onAction="#onBack" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: 600; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1; -fx-border-radius: 6; -fx-padding: 6 12;" text="← Back" />
            </HBox>
            
            <!-- Header Content -->
            <VBox alignment="CENTER" spacing="3.0">
                <Label fx:id="managerNameLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="Manager Name" />
                <Label fx:id="periodLabel" style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.85);" text="October 2025" />
            </VBox>
        </VBox>
        
        <!-- Progress Content -->
        <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20;">
        
        <VBox spacing="20.0">
            <!-- Car Progress Circle -->
            <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-letter-spacing: 1;" text="CAR SALES" />
                <StackPane>
                    <Circle fill="TRANSPARENT" radius="65.0" stroke="#e5e7eb" strokeWidth="12.0" />
                    <Circle fx:id="carProgressCircle" fill="TRANSPARENT" radius="65.0" stroke="#3b82f6" strokeDashArray="408.41" strokeDashOffset="408.41" strokeWidth="12.0" style="-fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 6, 0, 0, 2);" />
                    <VBox alignment="CENTER" spacing="2.0">
                        <Label fx:id="carProgressLabel" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" text="0%" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #94a3b8; -fx-font-weight: 600;" text="COMPLETE" />
                    </VBox>
                </StackPane>
                <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
                    <Label fx:id="carAchieveLabel" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0 / 10" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="ACHIEVED / TARGET" />
                </VBox>
            </VBox>
            
            <!-- Parts Progress Circle -->
            <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 12;">
                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-letter-spacing: 1;" text="PARTS SALES" />
                <StackPane>
                    <Circle fill="TRANSPARENT" radius="65.0" stroke="#e5e7eb" strokeWidth="12.0" />
                    <Circle fx:id="partProgressCircle" fill="TRANSPARENT" radius="65.0" stroke="#10b981" strokeDashArray="408.41" strokeDashOffset="408.41" strokeWidth="12.0" style="-fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 6, 0, 0, 2);" />
                    <VBox alignment="CENTER" spacing="2.0">
                        <Label fx:id="partProgressLabel" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="0%" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #94a3b8; -fx-font-weight: 600;" text="COMPLETE" />
                    </VBox>
                </StackPane>
                <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
                    <Label fx:id="partAchieveLabel" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0 / 50" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="ACHIEVED / TARGET" />
                </VBox>
            </VBox>
        </VBox>
        
        <!-- Action Buttons -->
        <HBox spacing="10.0" style="-fx-padding: 5 0 0 0;">
            <Button onAction="#onSetNewTarget" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 2);" text="🎯 New Target" HBox.hgrow="ALWAYS" />
            <Button onAction="#onRefresh" prefHeight="45.0" style="-fx-background-color: white; -fx-text-fill: #64748b; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 10;" text="🔄 Refresh" HBox.hgrow="ALWAYS" />
        </HBox>
        </VBox>
    </VBox>
</StackPane>
