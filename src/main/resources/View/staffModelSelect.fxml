<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" stylesheets="@../CSS/model_select.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.staffModelSelectController">
    <HBox fx:id="headerBox" styleClass="header-section" alignment="CENTER_LEFT" spacing="20">
        <Button fx:id="backbtn" styleClass="back-button" onAction="#goBack" text="BACK" />
        <VBox spacing="4">
            <Label fx:id="modelTitle" styleClass="model-title" text="Models" />
            <Label styleClass="model-subtitle" text="Select a model to customize" />
        </VBox>
        <Button fx:id="refreshButton" styleClass="refresh-button" onAction="#handleRefresh" text="⟳" />
    </HBox>
    <FlowPane fx:id="flow_Pane" styleClass="cars-flow-pane" />
</VBox>