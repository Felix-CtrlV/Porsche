<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<BorderPane prefHeight="580.0" prefWidth="1188.0"
            styleClass="main-background"
            stylesheets="@../CSS/model_select.css"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.staffModelSelectController">

    <center>
        <HBox alignment="CENTER" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" prefHeight="496.0" prefWidth="1086.0" HBox.hgrow="SOMETIMES">
                    <children>
                        <ScrollPane fx:id="scrollPane"
                                    fitToHeight="true"
                                    fitToWidth="false"
                                    prefHeight="492.0"
                                    prefWidth="1086.0"
                                    style="-fx-background-color: transparent; -fx-hbar-policy:never; -fx-vbar-policy:never;"
                                    VBox.vgrow="SOMETIMES">
                            <FlowPane fx:id="flow_Pane"
                                      hgap="16.0"
                                      prefHeight="449.0"
                                      prefWidth="5028.0"
                                      prefWrapLength="5000.0"
                                      styleClass="flow-pane">
                                <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="30.0" />
                                </padding>
                            </FlowPane>
                        </ScrollPane>
                    </children>
                    <HBox.margin>
                        <Insets left="5.0" right="5.0" />
                    </HBox.margin>
                </VBox>
            </children>
        </HBox>
    </center>

    <top>
        <VBox alignment="BOTTOM_CENTER" prefHeight="60.0" prefWidth="1188.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Button fx:id="back_btn" onAction="#goBack" styleClass="transparent-button" text="Back to selection" />
                    </children>
                </HBox>
                <Label styleClass="topic_font" text="Available Models Overview" />
            </children>
        </VBox>
    </top>

    <bottom>
        <Line endX="599.2929" endY="-1.0" startX="-100.0" styleClass="divider-line" BorderPane.alignment="TOP_CENTER">
            <BorderPane.margin>
                <Insets bottom="20.0" />
            </BorderPane.margin>
        </Line>
    </bottom>
</BorderPane>
